# Copy to .env (which git ignores) and set a real password.
POSTGRES_PASSWORD=change-me
# Port the API (HTTPS) listens on, on this machine.
SERVER_PORT=8443
# Folder with server.pem, server.key and brilliant-ca.crt from scripts/local-ca.sh (default ./tls). See docs/https.md.
#TLS_DIR=./tls
# The user the server runs as: your `id -u` and `id -g`. scripts/local-ca.sh sets these in .env for you; the TLS key is readable by
# its owner alone, so the server has to be that user.
#SERVER_UID=1000
#SERVER_GID=1000

# Nightly backup (docs/backup.md). All optional.
# Folder the dumps go in, on this machine (default ./backups). Create it first if you change it.
#BACKUP_DIR=./backups
# How many dumps to keep (default 14), and when to take one (HH:MM in BACKUP_TZ, default 03:00 UTC).
#BACKUP_KEEP=14
#BACKUP_AT=03:00
#BACKUP_TZ=Africa/Lagos
# Own the dump files as yourself rather than root: your `id -u` and `id -g` (the folder must be writable by you).
#BACKUP_UID=1000
#BACKUP_GID=1000

# Phone feedback on written answers (docs/csharp-answer-feedback.md). The Mac's Ollama, by the address your Mac has on the home network,
# for example http://192.168.1.50:11434. Needs the one-time OLLAMA_HOST setting on the Mac. Leave unset to switch the proxy off.
#OLLAMA_URL=http://192.168.1.50:11434
