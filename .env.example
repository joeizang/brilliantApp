# Copy to .env (which git ignores) and set a real password.
POSTGRES_PASSWORD=change-me
# Port the API listens on, on this machine.
SERVER_PORT=8080

# Nightly backup (docs/backup.md). All optional.
# Folder the dumps go in, on this machine (default ./backups). Create it first if you change it.
#BACKUP_DIR=./backups
# How many dumps to keep (default 14), and when to take one (HH:MM in BACKUP_TZ, default 03:00 UTC).
#BACKUP_KEEP=14
#BACKUP_AT=03:00
#BACKUP_TZ=Africa/Lagos
# Own the dump files as yourself rather than root: your `id -u` and `id -g` (the folder must be writable by you).
#BACKUP_UID=1000
#BACKUP_GID=1000
