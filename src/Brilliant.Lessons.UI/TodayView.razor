@* Today: the daily goal, the streak, what is due and what is next, and the one button that starts (or resumes) the day's session. *@
@using Brilliant.Core.Progress
@inject ProgressRecorder Recorder

@{
    var today = Recorder.Project(Content).Today;
    var pct = Math.Min(100, 100 * today.DoneToday / today.GoalSteps);
}
<div class="today">
    <h1 class="today-title">Today</h1>

    <p class="today-streak">
        <span class="streak-flame" aria-hidden="true">🔥</span>
        @if (today.Streak == 0)
        {
            <span>No streak yet. Meet today's goal to start one.</span>
        }
        else
        {
            <strong>@(today.Streak)-day streak</strong>
            @if (!today.GoalMet)
            {
                <span class="streak-hint">Meet today's goal to keep it going.</span>
            }
        }
    </p>

    <section class="today-goal" aria-label="Daily goal">
        <div class="goal-head">
            <span class="goal-text">@today.DoneToday of @today.GoalSteps steps@(today.GoalMet ? " · Goal met ✓" : "")</span>
            <span class="goal-stepper">
                <button class="goal-down" aria-label="Lower the daily goal" disabled="@(today.GoalSteps <= MinGoal)" @onclick="() => SetGoal(today.GoalSteps - Step)">−</button>
                <button class="goal-up" aria-label="Raise the daily goal" disabled="@(today.GoalSteps >= MaxGoal)" @onclick="() => SetGoal(today.GoalSteps + Step)">+</button>
            </span>
        </div>
        <div class="bar" role="progressbar" aria-label="Today's progress" aria-valuemin="0" aria-valuemax="@today.GoalSteps" aria-valuenow="@today.DoneToday">
            <span class="fill" style="width:@pct%"></span>
        </div>
        <p class="goal-note">A step is a lesson step finished or a review answered.</p>
    </section>

    @if (today.ReviewsDue > 0)
    {
        <button class="review-card" @onclick="() => OnOpenReview.InvokeAsync()">
            <span class="card-title">Review</span>
            <span class="card-meta">@today.ReviewsDue @(today.ReviewsDue == 1 ? "review" : "reviews") due</span>
        </button>
    }

    @if (today.NextLesson is { } next)
    {
        <section class="today-next">
            <span class="next-label">Up next</span>
            <span class="next-title">@next.Lesson.Title</span>
            <span class="next-meta">@TrackTitle(next) · @Caption(next)</span>
        </section>
    }

    @* An open session keeps its button even when the last step or answer used up all the work: its summary is still to be seen. *@
    @if (today.HasWork || today.Session is not null)
    {
        <div class="today-actions">
            <button class="primary start-session" @onclick="() => OnStart.InvokeAsync()">@(today.Session is not null ? "Resume session" : today.GoalMet ? "Do another session" : "Start today's session")</button>
            <button class="secondary browse" @onclick="() => OnBrowse.InvokeAsync()">Browse tracks</button>
        </div>
    }
    else
    {
        <p class="today-empty">You're all caught up. Nothing is due and every lesson is finished.</p>
        <div class="today-actions">
            <button class="secondary browse" @onclick="() => OnBrowse.InvokeAsync()">Browse tracks</button>
        </div>
    }
</div>

@code {
    private const int Step = 5;
    private const int MinGoal = 5;
    private const int MaxGoal = 100;

    [Parameter, EditorRequired] public ContentGraph Content { get; set; } = default!;

    /// <summary>Start the daily session, or resume today's unfinished one.</summary>
    [Parameter] public EventCallback OnStart { get; set; }

    [Parameter] public EventCallback OnBrowse { get; set; }
    [Parameter] public EventCallback OnOpenReview { get; set; }

    private void SetGoal(int steps) => Recorder.SetDailyGoal(Math.Clamp(steps, MinGoal, MaxGoal));

    private string TrackTitle(LessonState lesson) => Content.Get<Track>(lesson.Lesson.TrackId).Title;

    private static string Caption(LessonState lesson) => lesson.Status == LessonStatus.InProgress
        ? $"{lesson.Progress.Remaining} of {lesson.Progress.TotalSteps} steps left"
        : $"{lesson.Progress.TotalSteps} steps";
}
