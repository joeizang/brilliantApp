@* Today: the daily goal, the streak, what is due and what is next, and the one button that starts (or resumes) the day's session. *@
@using Brilliant.Core.Practice
@using Brilliant.Core.Progress
@inject ProgressRecorder Recorder

@{
    var learner = Recorder.Project(Content);
    var today = learner.Today;
    var suggestion = OnOpenPractice.HasDelegate ? PracticeSelector.Suggestion(learner) : [];
    var pct = Math.Min(100, 100 * today.DoneToday / today.GoalSteps);
    var arc = $"stroke-dashoffset:{100 - pct}" + (pct == 0 ? ";opacity:0" : "");   // an empty ring would still draw the round cap
}
<div class="today mx-auto box-border grid max-w-(--content-width) gap-4 px-6 pb-12">
    <h1 class="today-title mt-6 mb-0">Today</h1>

    <section class="today-goal panel grid gap-4 px-5 py-5 shadow-(--shadow-card)" aria-label="Daily goal">
        <div class="flex items-center gap-5">
            <div class="goal-ring @(today.GoalMet ? "met" : "")" role="progressbar" aria-label="Today's progress" aria-valuemin="0" aria-valuemax="@today.GoalSteps" aria-valuenow="@today.DoneToday">
                <svg class="goal-arc" viewBox="0 0 120 120" aria-hidden="true">
                    <circle class="arc-track" cx="60" cy="60" r="52" />
                    <circle class="arc-fill" cx="60" cy="60" r="52" pathLength="100" style="@arc" />
                </svg>
                <Flame Lit="today.Streak > 0" Roaring="today.GoalMet" Size="3.4rem" Class="streak-flame" />
            </div>
            <p class="today-streak m-0 grid min-w-0 gap-1">
                @if (today.Streak == 0)
                {
                    <span class="text-[1.2rem] leading-snug font-semibold">No streak yet. Meet today's goal to start one.</span>
                }
                else
                {
                    <strong class="text-[1.65rem] leading-none font-extrabold tracking-[-.03em]">@(today.Streak)-day streak</strong>
                    @if (!today.GoalMet)
                    {
                        <span class="streak-hint text-[1rem] text-fg-secondary">Meet today's goal to keep it going.</span>
                    }
                }
            </p>
        </div>
        <div class="goal-head flex items-center justify-between gap-4 border-t border-hairline pt-4">
            <span class="goal-text flex items-center gap-2 text-[1.1rem] font-semibold tabular-nums">
                @today.DoneToday of @today.GoalSteps steps@(today.GoalMet ? " · Goal met" : "")
                @if (today.GoalMet)
                {
                    <Icon Name="check" Class="icon-draw size-5 text-success" />
                }
            </span>
            <span class="goal-stepper flex gap-2">
                <button class="goal-down @StepperButton" aria-label="Lower the daily goal" disabled="@(today.GoalSteps <= MinGoal)" @onclick="() => SetGoal(today.GoalSteps - Step)"><Icon Name="minus" Class="mx-auto size-5" /></button>
                <button class="goal-up @StepperButton" aria-label="Raise the daily goal" disabled="@(today.GoalSteps >= MaxGoal)" @onclick="() => SetGoal(today.GoalSteps + Step)"><Icon Name="plus" Class="mx-auto size-5" /></button>
            </span>
        </div>
        <p class="goal-note m-0 text-[.85rem] text-fg-secondary">A step is a lesson step finished or a review answered.</p>
    </section>

    @if (today.ReviewsDue > 0)
    {
        <button class="@Styling.ReviewCard" @onclick="() => OnOpenReview.InvokeAsync()">
            <span class="card-title flex items-center gap-3 text-[1.2rem] font-semibold tracking-[-.01em]"><Icon Name="review" Class="size-7 text-accent" />Review</span>
            <span class="card-meta text-[.9rem] text-fg-secondary">@today.ReviewsDue @(today.ReviewsDue == 1 ? "review" : "reviews") due</span>
        </button>
    }

    @* With the review queue done, Practice is what keeps the patterns sharp (#128): suggest the weakest. *@
    @if (suggestion.Count > 0)
    {
        <button class="today-practice @Styling.PracticeCard" @onclick="() => OnOpenPractice.InvokeAsync()">
            <span class="card-title text-[1.2rem] font-semibold tracking-[-.01em]">Practice</span>
            <span class="card-meta text-[.9rem] text-fg-secondary">Reviews are done. Practise your weakest @(suggestion.Count == 1 ? "pattern" : "patterns"): @PracticeText.Titles(suggestion).@if (PracticeText.Streak(today) is { } streak){<br /><span class="practice-streak">@streak</span>}</span>
        </button>
    }

    @if (today.NextLesson is { } next)
    {
        <section class="today-next panel grid gap-[.2rem] px-6 py-5 shadow-(--shadow-card)">
            <span class="next-label text-[.9rem] font-semibold text-ember-text">Up next</span>
            <span class="next-title text-[1.2rem] font-semibold tracking-[-.01em]">@next.Lesson.Title</span>
            <span class="next-meta text-[.9rem] text-fg-secondary">@TrackTitle(next) · @Caption(next)</span>
        </section>
    }

    @* An open session keeps its button even when the last step or answer used up all the work: its summary is still to be seen. *@
    @if (today.HasWork || today.Session is not null)
    {
        <div class="today-actions mt-2 flex flex-wrap gap-4">
            <button class="primary start-session btn-primary" @onclick="() => OnStart.InvokeAsync()">@(today.Session is not null ? "Resume session" : today.GoalMet ? "Do another session" : "Start today's session")</button>
            <button class="secondary browse btn-secondary" @onclick="() => OnBrowse.InvokeAsync()">Browse tracks</button>
        </div>
    }
    else
    {
        <p class="today-empty mt-4 mb-0 text-[1.2rem]">You're all caught up. Nothing is due and every lesson is finished.</p>
        <div class="today-actions mt-2 flex flex-wrap gap-4">
            <button class="secondary browse btn-secondary" @onclick="() => OnBrowse.InvokeAsync()">Browse tracks</button>
        </div>
    }
</div>

@code {
    private const string StepperButton = "grid h-(--touch) w-(--touch) cursor-pointer place-items-center rounded-[50%] border border-border bg-surface p-0 text-fg transition-[background-color,scale] duration-150 ease-app hover:enabled:bg-accent-tint active:enabled:scale-90 disabled:cursor-default disabled:opacity-40";

    private const int Step = 5;
    private const int MinGoal = 5;
    private const int MaxGoal = 100;

    [Parameter, EditorRequired] public ContentGraph Content { get; set; } = default!;

    /// <summary>Start the daily session, or resume today's unfinished one.</summary>
    [Parameter] public EventCallback OnStart { get; set; }

    [Parameter] public EventCallback OnBrowse { get; set; }
    [Parameter] public EventCallback OnOpenReview { get; set; }

    /// <summary>Opens Practice. Without it Today suggests no practice.</summary>
    [Parameter] public EventCallback OnOpenPractice { get; set; }

    private void SetGoal(int steps) => Recorder.SetDailyGoal(Math.Clamp(steps, MinGoal, MaxGoal));

    private string TrackTitle(LessonState lesson) => Content.Get<Track>(lesson.Lesson.TrackId).Title;

    private static string Caption(LessonState lesson) => lesson.Status == LessonStatus.InProgress
        ? $"{lesson.Progress.Remaining} of {lesson.Progress.TotalSteps} steps left"
        : $"{lesson.Progress.TotalSteps} steps";
}
