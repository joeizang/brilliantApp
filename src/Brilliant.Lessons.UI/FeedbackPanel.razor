@* The advisory feedback on a written answer: waiting, unavailable, or the points made and the red flags found. Never part of a grade. *@
@using Brilliant.Core.Feedback
<section class="feedback mt-6" aria-label="Feedback" aria-live="polite">
    <h3 class="mb-1">Feedback</h3>
    <p class="mt-0 mb-2 text-[.95rem] text-fg-secondary">Advisory, from a local model. Your own ticks set the grade.</p>
    @if (State == FeedbackState.Pending)
    {
        <p class="feedback-pending m-0 text-fg-secondary">Getting feedback…</p>
    }
    else if (State == FeedbackState.Unavailable)
    {
        <p class="feedback-unavailable m-0 text-fg-secondary">@Problem</p>
    }
    else if (Feedback is not null)
    {
        <ul class="m-0 mb-4 grid list-none gap-2 p-0">
            @foreach (var point in Feedback.Points)
            {
                <li class="feedback-point rounded-lg border border-hairline bg-surface-raised px-4 py-2" data-point="@point.Index" data-verdict="@(point.Hit ? "hit" : "missed")">
                    <div class="font-semibold"><span class="@(point.Hit ? "text-success" : "text-fg-secondary")">@(point.Hit ? "✓ Made" : "✗ Missed")</span>: @point.Point</div>
                    @if (point.Note.Length > 0)
                    {
                        <div class="mt-[.2rem] text-[.9rem] text-fg-secondary">@point.Note</div>
                    }
                </li>
            }
        </ul>
        @if (Feedback.RedFlagsFound.Count > 0)
        {
            <h4 class="mb-1">Red flags in your answer</h4>
            <ul class="m-0 grid list-none gap-2 p-0">
                @foreach (var flag in Feedback.RedFlagsFound)
                {
                    <li class="feedback-flag rounded-lg border border-hairline bg-surface-raised px-4 py-2" data-flag="@flag.Index">
                        <div class="font-semibold"><span class="text-danger">⚠</span> @flag.Flag</div>
                        @if (flag.Note.Length > 0)
                        {
                            <div class="mt-[.2rem] text-[.9rem] text-fg-secondary">@flag.Note</div>
                        }
                    </li>
                }
            </ul>
        }
    }
</section>

@code {
    [Parameter] public FeedbackState State { get; set; }
    [Parameter] public string Problem { get; set; } = "";
    [Parameter] public AnswerFeedback? Feedback { get; set; }
}
