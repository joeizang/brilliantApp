@using Brilliant.Core.Content

<article class="async-timeline-step lesson-step">
    <h2>@Step.Title</h2>
    <div class="async-timeline-body mb-4 max-w-(--content-width)">@((MarkupString)MarkdownHtml.ToHtml(Step.Body))</div>

    @if (Deadlock is { } deadlock)
    {
        <aside class="async-deadlock rounded-lg border border-danger bg-surface-raised p-4" role="note" aria-label="Sync-over-async deadlock">
            <strong>Sync-over-async deadlock</strong>
            <p class="mt-2 mb-0">Thread <code>@deadlock.Thread</code> blocks waiting for <code>@deadlock.Operation</code> at event @deadlock.BlockingSequence. Its continuation is queued back to <code>@deadlock.Thread</code> at event @deadlock.ContinuationSequence, so the work cannot finish until the blocked thread runs it.</p>
        </aside>
    }

    <div class="async-lanes mt-5" role="group" aria-label="Recorded async timeline by thread">
        @foreach (var thread in Threads)
        {
            <section class="async-lane rounded-lg border border-hairline bg-surface-raised p-3" aria-label="Thread @thread">
                <h3 class="async-lane-title mb-3">@thread</h3>
                <ol class="async-events">
                    @foreach (var item in Step.Events.Where(e => ThreadName(e.Thread) == thread).OrderBy(e => e.Sequence))
                    {
                        <li class="async-event rounded-md border border-hairline bg-surface p-3">
                            <span class="async-event-order"><span class="sr-only">Event </span>@item.Sequence</span>
                            <span class="async-event-kind">@KindLabel(item.Kind)</span>
                            <p class="mb-0 mt-1">@item.Label</p>
                            @if (!string.IsNullOrWhiteSpace(item.Operation)) { <p class="async-event-meta mb-0 mt-2">Operation: <code>@item.Operation</code></p> }
                            @if (!string.IsNullOrWhiteSpace(item.State)) { <p class="async-event-meta mb-0 mt-1">State machine: <code>@item.State</code></p> }
                            @if (!string.IsNullOrWhiteSpace(item.ContinuationThread)) { <p class="async-event-meta mb-0 mt-1">Continuation resumes on <strong>@ThreadName(item.ContinuationThread)</strong></p> }
                        </li>
                    }
                </ol>
            </section>
        }
    </div>

    <details class="async-event-list mt-4">
        <summary>Read events in exact execution order</summary>
        <ol class="mt-3">
            @foreach (var item in Step.Events.OrderBy(e => e.Sequence))
            {
                <li><strong>@item.Sequence · @KindLabel(item.Kind)</strong> on @ThreadName(item.Thread): @item.Label
                    @if (!string.IsNullOrWhiteSpace(item.State)) { <span> (state machine: @item.State)</span> }
                    @if (!string.IsNullOrWhiteSpace(item.ContinuationThread)) { <span> → continuation on @ThreadName(item.ContinuationThread)</span> }
                </li>
            }
        </ol>
    </details>
</article>

@code {
    [Parameter, EditorRequired] public AsyncTimelineStep Step { get; set; } = default!;

    private IReadOnlyList<string> Threads => Step.Events
        .SelectMany(e => string.IsNullOrWhiteSpace(e.ContinuationThread) ? [ThreadName(e.Thread)] : new[] { ThreadName(e.Thread), ThreadName(e.ContinuationThread!) })
        .Distinct(StringComparer.Ordinal)
        .ToList();

    private AsyncTimelineDeadlock? Deadlock => AsyncTimelineAnalysis.FindSyncOverAsyncDeadlock(Step);

    private static string ThreadName(string thread) => thread.Trim();

    private static string KindLabel(AsyncTimelineEventKind kind) => kind switch
    {
        AsyncTimelineEventKind.ContinuationQueued => "Continuation queued",
        AsyncTimelineEventKind.BlockingWait => "Blocking wait",
        _ => kind.ToString(),
    };
}
