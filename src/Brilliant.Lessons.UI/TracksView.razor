@using Brilliant.Core.Practice
@using Brilliant.Core.Progress
@inject ProgressRecorder Recorder

@{
    var learner = Recorder.Project(Content);
    var due = learner.Queue.Items.Count;
    var practice = PracticeSelector.Availability(learner);
    var interview = OnOpenInterview.HasDelegate ? InterviewRuns.Open(Recorder.Log.ReadAll()) : null;
}
@if (OnBack.HasDelegate)
{
    <div class="crumbs content-column"><button class="link btn-link" @onclick="() => OnBack.InvokeAsync()">← Today</button></div>
}
<h1 class="screen-title content-column mt-6">Tracks</h1>
@if (due > 0)
{
    <button class="@Styling.ReviewCard mt-4" @onclick="() => OnOpenReview.InvokeAsync()">
        <span class="card-title flex items-center gap-3 text-[1.2rem] font-semibold tracking-[-.01em]"><Icon Name="review" Class="size-7 text-accent" />Review</span>
        <span class="card-meta text-[.9rem] text-fg-secondary">@due due</span>
    </button>
}
else
{
    <p class="review-none content-column mt-4 text-[.95rem] text-fg-secondary">No reviews due.</p>
}
@if (OnOpenPractice.HasDelegate)
{
    @if (practice.IsAvailable)
    {
        <button class="@Styling.PracticeCard mt-4" @onclick="() => OnOpenPractice.InvokeAsync()">
            <span class="card-title text-[1.2rem] font-semibold tracking-[-.01em]">Practice</span>
            <span class="card-meta text-[.9rem] text-fg-secondary">Name the pattern, then solve it.@if (PracticeText.Weakest(learner) is { } weakest){<br /><span class="practice-weakest">Weakest: @weakest</span>}@if (PracticeText.Streak(learner.Today) is { } streak){<br /><span class="practice-streak">@streak</span>}</span>
        </button>
    }
    else
    {
        <button class="@Styling.PracticeCard mt-4" disabled>
            <span class="card-title text-[1.2rem] font-semibold tracking-[-.01em]">Practice</span>
            <span class="practice-reason card-meta text-[.9rem] text-fg-secondary">@PracticeText.Unavailable(practice)</span>
        </button>
    }
}
@if (OnOpenInterview.HasDelegate)
{
    @* A run in progress is open whatever Practice's state: it has to be finished, and its clock is already running. *@
    <button class="@InterviewCard mt-4" disabled="@(interview is null && !practice.IsAvailable)" @onclick="() => OnOpenInterview.InvokeAsync()">
        <span class="card-title text-[1.2rem] font-semibold tracking-[-.01em]">Timed interview</span>
        <span class="interview-status card-meta text-[.9rem] text-fg-secondary">@InterviewStatus(interview, practice)</span>
    </button>
}
<ul class="cards content-column mt-4 mb-6 grid list-none gap-4">
    @foreach (var state in learner.Tracks)
    {
        var pct = state.TotalLessons == 0 ? 0 : 100 * state.CompletedLessons / state.TotalLessons;
        <li>
            <button class="@Styling.TrackCard" @onclick="() => OnOpenTrack.InvokeAsync(state.Track)">
                <span class="card-title flex items-center justify-between gap-3 text-[1.25rem] font-bold tracking-[-.02em]">@state.Track.Title@if (state.IsComplete){<span class="grid size-8 flex-none place-items-center rounded-full bg-success-tint text-success"><Icon Name="check" Class="icon-draw size-5" /></span><span class="sr-only">complete</span>}</span>
                <span class="card-meta text-[.9rem] text-fg-secondary">@state.CompletedLessons of @state.TotalLessons lessons complete</span>
                <span class="bar progress-bar"><span class="fill progress-fill" style="width:@pct%"></span></span>
                <MasteryBar Value="learner.TrackMastery(state.Track.Id)" Label="@("Mastery of " + state.Track.Title)" Suffix="mastered" />
            </button>
        </li>
    }
</ul>
@if (OnOpenFlagged.HasDelegate || OnOpenSync.HasDelegate)
{
    @* The sidebar is hidden on narrow windows, so these are how the narrow layout reaches them. *@
    <div class="content-column mb-6 flex flex-wrap items-center gap-x-6 gap-y-2">
        @if (OnOpenFlagged.HasDelegate)
        {
            <button class="flagged-link link btn-link text-fg-secondary" @onclick="() => OnOpenFlagged.InvokeAsync()">Flagged steps</button>
        }
        @if (OnOpenSync.HasDelegate)
        {
            <button class="sync-link link btn-link text-fg-secondary" @onclick="() => OnOpenSync.InvokeAsync()">Sync</button>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public ContentGraph Content { get; set; } = default!;
    [Parameter] public EventCallback<Track> OnOpenTrack { get; set; }
    [Parameter] public EventCallback OnOpenReview { get; set; }

    /// <summary>Opens Practice. Without it there is no Practice card.</summary>
    [Parameter] public EventCallback OnOpenPractice { get; set; }

    /// <summary>Opens the timed interview. Without it there is no interview card.</summary>
    [Parameter] public EventCallback OnOpenInterview { get; set; }
    [Parameter] public EventCallback OnOpenFlagged { get; set; }
    [Parameter] public EventCallback OnOpenSync { get; set; }

    /// <summary>Back to Today, when Tracks is reached from there.</summary>
    [Parameter] public EventCallback OnBack { get; set; }

    private static readonly string InterviewCard = Styling.PracticeCard.Replace("practice-card", "interview-card");

    private string InterviewStatus(InterviewRun? run, PracticeAvailability practice) =>
        run is null ? practice.IsAvailable ? "1 to 5 problems against one clock." : PracticeText.Unavailable(practice)
        : run.IsOver(Recorder.Now) ? "Time's up. See how you did."
        : $"In progress: {Math.Max(1, (int)Math.Ceiling(run.Left(Recorder.Now).TotalMinutes))} min left.";
}
