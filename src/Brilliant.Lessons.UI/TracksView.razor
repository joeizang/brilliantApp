@using Brilliant.Core.Progress
@inject ProgressRecorder Recorder

@{
    var learner = Recorder.Project(Content);
    var due = learner.Queue.Items.Count;
}
@if (OnBack.HasDelegate)
{
    <div class="crumbs content-column"><button class="link btn-link" @onclick="() => OnBack.InvokeAsync()">← Today</button></div>
}
<h1 class="screen-title content-column mt-6">Tracks</h1>
@if (due > 0)
{
    <button class="@Styling.ReviewCard mt-4" @onclick="() => OnOpenReview.InvokeAsync()">
        <span class="card-title text-[1.2rem] font-semibold tracking-[-.01em]">Review</span>
        <span class="card-meta text-[.9rem] text-fg-secondary">@due due</span>
    </button>
}
else
{
    <p class="review-none mt-4 text-[.95rem] text-fg-secondary">No reviews due.</p>
}
<ul class="cards content-column mt-4 mb-6 grid list-none gap-4">
    @foreach (var state in learner.Tracks)
    {
        var pct = state.TotalLessons == 0 ? 0 : 100 * state.CompletedLessons / state.TotalLessons;
        <li>
            <button class="@Styling.TrackCard" @onclick="() => OnOpenTrack.InvokeAsync(state.Track)">
                <span class="card-title text-[1.2rem] font-semibold tracking-[-.01em]">@state.Track.Title @(state.IsComplete ? "✓" : "")</span>
                <span class="card-meta text-[.9rem] text-fg-secondary">@state.CompletedLessons of @state.TotalLessons lessons complete</span>
                <span class="bar progress-bar"><span class="fill progress-fill" style="width:@pct%"></span></span>
                <MasteryBar Value="learner.TrackMastery(state.Track.Id)" Label="@("Mastery of " + state.Track.Title)" Suffix="mastered" />
            </button>
        </li>
    }
</ul>
@if (OnOpenFlagged.HasDelegate)
{
    <div class="content-column mb-6"><button class="flagged-link link btn-link text-fg-secondary" @onclick="() => OnOpenFlagged.InvokeAsync()">Flagged steps</button></div>
}

@code {
    [Parameter, EditorRequired] public ContentGraph Content { get; set; } = default!;
    [Parameter] public EventCallback<Track> OnOpenTrack { get; set; }
    [Parameter] public EventCallback OnOpenReview { get; set; }
    [Parameter] public EventCallback OnOpenFlagged { get; set; }

    /// <summary>Back to Today, when Tracks is reached from there.</summary>
    [Parameter] public EventCallback OnBack { get; set; }
}
