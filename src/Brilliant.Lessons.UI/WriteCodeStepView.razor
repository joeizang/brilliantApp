@using Brilliant.Core.Drafts
@using Brilliant.Core.Code
@inject CodeRuntimeRegistry Runtimes
@inject ICodeDraftStore Drafts
@inject StepShortcuts Shortcuts
@inject ScreenInfo Screen
@implements IDisposable

<article class="write-step lesson-step">
    <h2>@(Title ?? Step.Title)</h2>
    <p class="prompt">@Step.Prompt</p>

    @if (Screen.RequiresPhoneAlternative(Step))
    {
        <p role="note">Open this lesson on your Mac to write and run C#.</p>
    }
    else
    {
    <CodeEditor @ref="_editor" InitialCode="@_initialCode" OnChanged="SaveDraft" Language="@Step.Language" />

    <div class="run-row mb-4 flex flex-wrap items-center gap-4">
        <button class="primary btn-primary" disabled="@_running" @onclick="Submit">@(_running ? "Running…" : "Run tests")</button>
        @if (_confirmingReset)
        {
            <span class="reset-confirm flex flex-wrap items-center gap-3" role="alertdialog" aria-label="Reset code">
                <span class="text-[.95rem]">Replace your code with the starting code? Your changes will be lost.</span>
                <button class="secondary btn-secondary" @onclick="ResetToStarter">Yes, reset</button>
                <button class="link btn-link" @onclick="() => _confirmingReset = false">Keep my code</button>
            </span>
        }
        else
        {
            <button class="link reset btn-link ml-auto" disabled="@_running" @onclick="() => _confirmingReset = true">Reset to starter</button>
        }
        @if (_running && !_warmedUp)
        {
            <span class="note text-[.95rem] text-fg-secondary">Starting @CodeLanguages.DisplayName(Step.Language)… the first run takes a few seconds.</span>
        }
    </div>

    <div aria-live="polite">
        @if (_runtimeFailure is not null)
        {
            <p class="verdict incorrect font-semibold text-danger" role="alert">Couldn't run your code: @_runtimeFailure</p>
        }
        else if (_result is { } result)
        {
            @switch (result.Status)
            {
                case TestRunStatus.Passed:
                    <p class="verdict correct font-semibold text-success" role="status">All @result.Tests.Count tests passed! 🎉</p>
                    @foreach (var advice in result.Tests.Select(t => t.Allocation).OfType<AllocationReport>().Where(a => !a.Measured || (!a.Enforced && a.Exceeded)).Take(1))
                    {
                        if (!advice.Measured)
                        {
                            <p class="allocation-advice text-fg-secondary" role="note">Allocation not checked: your code is too slow to repeat enough times to measure its allocations here. The tests passed.</p>
                        }
                        else
                        {
                            <p class="allocation-advice text-fg-secondary" role="note">Allocation advice: a call allocated @advice.Bytes!.Value.ToString("N0") bytes on this device's @advice.Runtime runtime, over the @advice.Budget.ToString("N0")-byte budget. Allocation sizes differ between runtimes, so this doesn't fail the test; the lesson's budget is checked on CoreCLR when the lesson is published.</p>
                        }
                    }
                    break;

                case TestRunStatus.TimedOut:
                    <p class="verdict incorrect font-semibold text-danger" role="status">@result.Message</p>
                    break;

                case TestRunStatus.Error:
                    <p class="verdict incorrect font-semibold text-danger" role="status">@result.Message</p>
                    @TracebackBlock(result.Traceback)
                    break;

                default:
                    var failure = result.FirstFailure!;
                    <p class="verdict incorrect font-semibold text-danger" role="status">Not yet: @result.PassedCount of @result.Tests.Count tests passed.</p>
                    <section class="failure mb-4 rounded-md border border-hairline bg-surface-raised px-4 pt-[.6rem] pb-4" aria-label="First failing test">
                        <h3 class="my-[.4rem] text-[1.05rem]">First failing test</h3>
                        <dl class="mx-0 mt-0 mb-2 grid grid-cols-[max-content_1fr] gap-x-4 gap-y-[.3rem]">
                            <dt class="text-fg-secondary">Call</dt><dd class="m-0 overflow-x-auto"><code class="text-[.9rem] whitespace-pre-wrap">@failure.Call</code></dd>
                            @if (failure.Allocation is { Exceeded: true } allocation)
                            {
                                <dt class="text-fg-secondary">Allocation budget</dt><dd class="m-0">at most <code class="text-[.9rem]">@allocation.Budget.ToString("N0")</code> bytes per call</dd>
                                <dt class="text-fg-secondary">Your code allocated</dt><dd class="m-0"><code class="text-[.9rem]">@allocation.Bytes!.Value.ToString("N0")</code> bytes per call (@allocation.Runtime)</dd>
                            }
                            else
                            {
                                <dt class="text-fg-secondary">Expected</dt><dd class="m-0 overflow-x-auto"><code class="text-[.9rem] whitespace-pre-wrap">@failure.Expected</code></dd>
                                <dt class="text-fg-secondary">Your code returned</dt><dd class="m-0 overflow-x-auto">@if (failure.Actual is null) { <em>nothing, it raised an error</em> } else { <code class="text-[.9rem] whitespace-pre-wrap">@failure.Actual</code> }</dd>
                            }
                        </dl>
                        @TracebackBlock(failure.Traceback)
                    </section>
                    break;
            }

            @* Print output is shown whatever the verdict: from loading the file and from every test call. *@
            @foreach (var section in result.Outputs)
            {
                @StdoutBlock(section.Label, section.Text)
            }

            @if (result.Status == TestRunStatus.Passed && OfferContinue)
            {
                <button class="primary btn-primary" @onclick="() => OnContinue.InvokeAsync()">Continue</button>
            }
        }
    </div>
    }
</article>

@code {
    /// <summary>What the learner submitted and how it did.</summary>
    public sealed record Submission(string Code, TestRunResult Result);

    [Parameter, EditorRequired] public WriteCodeStep Step { get; set; } = default!;

    /// <summary>Shown instead of the step's title: Practice shows a problem as "Problem", so the title can't name its pattern.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>
    /// Where the learner's code is autosaved. Defaults to the step's ID, so a lesson keeps one draft per step. Review passes its own,
    /// so a re-solve neither starts from nor overwrites the solution the learner saved in the lesson.
    /// </summary>
    [Parameter] public string? DraftKey { get; set; }

    /// <summary>Raised each time the learner runs their code against the tests (pass or fail).</summary>
    [Parameter] public EventCallback<Submission> OnSubmitted { get; set; }

    /// <summary>Raised when the learner continues after all tests pass.</summary>
    [Parameter] public EventCallback OnContinue { get; set; }

    /// <summary>Offer Continue once the tests pass. An interview doesn't: the learner submits when ready, and moves on from there.</summary>
    [Parameter] public bool OfferContinue { get; set; } = true;

    private string Key => DraftKey ?? Step.Id;
    private CodeEditor _editor = default!;
    private string _initialCode = "";
    private bool _confirmingReset;
    private bool _resetting;
    private bool _running;
    private bool _warmedUp;
    private TestRunResult? _result;
    private string? _runtimeFailure;

    private IDisposable? _shortcuts;

    protected override void OnInitialized()
    {
        _initialCode = Drafts.Get(Key) ?? Step.Starter;
        _shortcuts = Shortcuts.Subscribe(OnShortcut);
    }

    public void Dispose() => _shortcuts?.Dispose();

    // ⌘↩ runs the tests (also while they are already running, when it does nothing); Return continues once they pass.
    private Task OnShortcut(StepShortcut s) => InvokeAsync(async () =>
    {
        switch (s.Command)
        {
            case StepCommand.Run when !_running:
                await Submit();
                break;
            case StepCommand.Advance when _result is { Status: TestRunStatus.Passed } && OfferContinue:
                await OnContinue.InvokeAsync();
                return;
        }
        StateHasChanged();
    });

    // Code that matches the starter is stored as "no draft", so a later change to the starter still reaches learners who never edited it.
    private void SaveDraft(string code)
    {
        if (_resetting) return;   // an edit reported while a reset is in flight is the text being replaced
        if (code == Step.Starter) Drafts.Reset(Key);
        else Drafts.Save(Key, code);
    }

    private async Task ResetToStarter()
    {
        _confirmingReset = false;
        _result = null;
        _runtimeFailure = null;
        _resetting = true;
        try
        {
            Drafts.Reset(Key);
            await _editor.SetCodeAsync(Step.Starter);
            await _editor.ClearErrorMarkersAsync();
            await _editor.HighlightLineAsync(null);
        }
        finally
        {
            // Whatever autosave callbacks arrived during the JS round trips were ignored; the reset has the last word.
            Drafts.Reset(Key);
            _resetting = false;
        }
    }

    /// <summary>
    /// Runs the code in the editor against the tests, as the Run button does, and returns how it did: null when the runtime itself couldn't
    /// run. An interview submits a solution this way, so what is judged is the code as it stands.
    /// </summary>
    public async Task<Submission?> RunAsync()
    {
        await Submit();
        return _result is { } result ? new Submission(await _editor.GetCodeAsync(), result) : null;
    }

    private async Task Submit()
    {
        if (Screen.RequiresPhoneAlternative(Step)) return;
        _running = true;
        _result = null;
        _runtimeFailure = null;
        StateHasChanged();   // a run started from the keyboard has no click to trigger the render that disables the button
        await _editor.ClearErrorMarkersAsync();
        await _editor.HighlightLineAsync(null);

        var code = await _editor.GetCodeAsync();
        try
        {
            _result = await Runtimes.Resolve(Step.Language).RunTestsAsync(code, Step.Entrypoint, Step.Tests);
            _warmedUp = true;
        }
        catch (Exception ex)
        {
            // The runtime itself failed (e.g. the Python worker couldn't start); that says nothing about the learner's code.
            _runtimeFailure = ex.Message;
        }
        finally
        {
            _running = false;
        }

        if (_result is null) return;
        await OnSubmitted.InvokeAsync(new Submission(code, _result));
        await MarkErrorLine(_result);
    }

    private async Task MarkErrorLine(TestRunResult result)
    {
        var (line, trace) = result.Status == TestRunStatus.Error
            ? (result.ErrorLine, result.Traceback)
            : (result.FirstFailure?.ErrorLine, result.FirstFailure?.Traceback);
        if (line is not { } n || trace is null) return;
        var message = trace.Split('\n', StringSplitOptions.RemoveEmptyEntries).LastOrDefault()?.Trim() ?? "Error";
        await _editor.SetErrorMarkersAsync([new EditorMarker(n, message)]);
        await _editor.HighlightLineAsync(n);
    }

    // Razor templates (not RenderTreeBuilder) so the component's scoped CSS applies to what they render.
    private static RenderFragment StdoutBlock(string label, string stdout) =>
        @<text>@if (!string.IsNullOrEmpty(stdout)) { <div class="output"><h4 class="mt-[.6rem] mb-[.2rem] text-[.9rem] font-semibold text-fg-secondary">@label</h4><pre>@stdout</pre></div> }</text>;

    private RenderFragment TracebackBlock(string? traceback) =>
        @<text>@if (!string.IsNullOrEmpty(traceback)) { <pre class="traceback border-l-4 border-l-danger whitespace-pre-wrap" aria-label="@(CodeLanguages.DisplayName(Step.Language) + " error")">@traceback</pre> }</text>;
}
