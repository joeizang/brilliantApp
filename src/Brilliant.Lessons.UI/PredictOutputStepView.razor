@implements IDisposable
@inject StepShortcuts Shortcuts

<article class="predict-step lesson-step">
    <h2>@Step.Title</h2>
    <p class="prompt">@Step.Prompt</p>
    <pre class="code-block" data-language="@Step.Code.Language"><code>@Step.Code.Code</code></pre>
    @Aside

    @if (Step.IsTyped)
    {
        <textarea class="answer-input box-border w-full resize-y rounded-md border border-border bg-surface px-4 py-3 font-mono text-[1rem] leading-[normal] text-fg transition-shadow duration-150 ease-app focus:ring-2 focus:ring-accent focus:outline-none mb-4" rows="@Math.Max(1, Math.Min(6, _response.Split('\n').Length))" placeholder="@Placeholder"
                  aria-label="@AnswerLabel" spellcheck="false" autocomplete="off" autocapitalize="off"
                  disabled="@Locked" @bind="_response" @bind:event="oninput"></textarea>
    }
    else
    {
        <ul class="options my-4 grid list-none gap-2 p-0">
            @for (var i = 0; i < Step.Options.Count; i++)
            {
                var index = i;
                var picked = _picked == index;
                <li class="@OptionClass(index, picked)">
                    <label class="flex min-h-6 cursor-pointer items-center gap-3">
                        <input type="radio" name="@Step.Id" checked="@picked" disabled="@Locked" @onchange="() => _picked = index" />
                        @Step.Options[index].Text
                    </label>
                    @if (_result is not null && picked && _result.Feedback is { Length: > 0 })
                    {
                        <div class="option-feedback mt-[.4rem] text-[.9rem] text-fg-secondary">@_result.Feedback</div>
                    }
                </li>
            }
        </ul>
    }

    @if (_result is null)
    {
        <button class="primary btn-primary" disabled="@(!CanCheck)" @onclick="Check">Check</button>
    }
    else if (_result.IsCorrect)
    {
        <p class="verdict correct font-semibold text-success" role="status">Correct!</p>
        <button class="primary btn-primary" @onclick="() => OnContinue.InvokeAsync()">Continue</button>
    }
    else
    {
        <p class="verdict incorrect font-semibold text-danger" role="status">Not quite. Have another go.</p>
        @if (Step.IsTyped && _result.Feedback is { Length: > 0 })
        {
            <p class="mistake-feedback mt-[.4rem] text-[.95rem] text-fg-secondary">@_result.Feedback</p>
        }
        <button class="primary btn-primary" @onclick="TryAgain">Try again</button>
    }
</article>

@code {
    /// <summary>What the learner submitted: <see cref="Response"/> for typed, <see cref="Selected"/> for multiple choice.</summary>
    public sealed record Attempt(AnswerResult Result, string? Response, int? Selected);

    [Parameter, EditorRequired] public PredictOutputStep Step { get; set; } = default!;

    /// <summary>Extra content under the code, such as a lowered step's compiler output.</summary>
    [Parameter] public RenderFragment? Aside { get; set; }

    [Parameter] public string Placeholder { get; set; } = "Type the output";

    [Parameter] public string AnswerLabel { get; set; } = "Predicted output";

    /// <summary>Raised each time the learner checks an answer (correct or not).</summary>
    [Parameter] public EventCallback<Attempt> OnAnswered { get; set; }

    /// <summary>Raised when the learner continues after a correct answer.</summary>
    [Parameter] public EventCallback OnContinue { get; set; }

    private IDisposable? _shortcuts;

    protected override void OnInitialized() => _shortcuts = Shortcuts.Subscribe(OnShortcut);

    public void Dispose() => _shortcuts?.Dispose();

    private string _response = "";
    private int? _picked;
    private AnswerResult? _result;

    private bool Locked => _result is not null;
    private bool CanCheck => Step.IsTyped ? !string.IsNullOrWhiteSpace(_response) : _picked is not null;

    private async Task Check()
    {
        _result = Step.IsTyped
            ? AnswerEvaluator.Evaluate(Step, _response)
            : AnswerEvaluator.Evaluate(Step, _picked!.Value);
        await OnAnswered.InvokeAsync(new Attempt(_result, Step.IsTyped ? _response : null, _picked));
    }

    private void TryAgain()
    {
        _result = null;
        _picked = null; // typed answers stay in the box so the learner can edit them
    }

    private Task OnShortcut(StepShortcut s) => InvokeAsync(async () =>
    {
        switch (s.Command)
        {
            case StepCommand.Choose when !Step.IsTyped && !Locked && s.Number <= Step.Options.Count:
                _picked = s.Number - 1;
                break;
            case StepCommand.Run or StepCommand.Advance when _result is null:
                if (CanCheck) await Check();
                break;
            case StepCommand.Advance when _result is { IsCorrect: true }:
                await OnContinue.InvokeAsync();
                return;
            case StepCommand.Advance:
                TryAgain();
                break;
        }
        StateHasChanged();
    });

    private string OptionClass(int index, bool picked)
    {
        if (_result is null) return Styling.Option(picked ? OptionState.Selected : OptionState.Idle);
        if (picked) return Styling.Option(Step.Options[index].Correct ? OptionState.Right : OptionState.Wrong);
        return Styling.Option(OptionState.Idle);
    }
}
