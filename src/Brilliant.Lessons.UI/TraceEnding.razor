@* How a recording ended: what the code printed, the error that stopped it, or that it was cut short. Shown on the last step. *@
@using Brilliant.Core.Code

<div class="trace-ending mt-4 empty:hidden" aria-live="polite">
    @if (Result.Status == TraceStatus.Error)
    {
        <div class="trace-error" role="status">
            <p class="verdict incorrect font-medium text-danger">@(Result.Message ?? "The code raised an error.")</p>
            @if (!string.IsNullOrEmpty(Result.Traceback))
            {
                <pre class="traceback m-0 rounded-sm border-l-[.25rem] border-l-danger px-4 py-2 whitespace-pre-wrap" aria-label="@(CodeLanguages.DisplayName(Language) + " error")">@Result.Traceback</pre>
            }
        </div>
    }
    else if (Result.Status == TraceStatus.Truncated)
    {
        <p class="trace-note text-fg-secondary">@(Result.Message ?? "The example runs for more steps than can be shown. The recording stops here.")</p>
    }
    @if (!string.IsNullOrEmpty(Result.Stdout))
    {
        <div class="trace-output">
            <h4 class="mt-[.6rem] mb-[.2rem] text-[.9rem] font-semibold text-fg-secondary">Printed</h4>
            <pre class="m-0 rounded-sm px-4 py-2 whitespace-pre-wrap">@Result.Stdout</pre>
        </div>
    }
</div>

@code {
    [Parameter] public string Language { get; set; } = "python";

    [Parameter, EditorRequired] public TraceResult Result { get; set; } = default!;
}
