@using Brilliant.Core.Progress
@using Brilliant.Core.Review
@inject ProgressRecorder Recorder

@{
    var learner = Recorder.Project(Content);
    var concept = learner.Concept(ConceptId);
}
<div class="crumbs content-column mt-2 text-[.95rem]"><button class="link btn-link" @onclick="() => OnBack.InvokeAsync()"><Icon Name="back" Class="size-5" /> @(concept is null ? "Back" : TrackTitle(learner, concept))</button></div>
@if (concept is null)
{
    <h1 class="screen-title content-column mt-0 mb-1">Concept not found</h1>
    <p class="track-meta content-column my-0 text-fg-secondary">This concept is no longer part of the course.</p>
}
else
{
    var offset = learner.AsOf.Offset;
    var lesson = concept.Lesson;
    <h1 class="screen-title content-column mt-0 mb-1">@concept.Concept.Title</h1>
    <section class="concept-head mt-2 grid gap-2">
        <p class="concept-level m-0"><span class="level-pill @concept.Level.ToString().ToLowerInvariant() @Styling.LevelPill(concept.Level) inline-block rounded-full px-[.7rem] py-[.1rem] text-[.8rem] font-medium">@ConceptText.Level(concept.Level)</span></p>
        <MasteryBar Value="concept.Mastery" Label="@("Mastery of " + concept.Concept.Title)" Suffix="mastered" />
        <p class="track-meta concept-lesson content-column my-0 flex flex-wrap items-center gap-4 text-fg-secondary">
            Taught in <strong>@lesson.Lesson.Title</strong>
            <button class="secondary revisit btn-secondary" disabled="@(lesson.Status == LessonStatus.Locked)"
                    @onclick="() => OnOpenLesson.InvokeAsync((lesson.Lesson, lesson.Status == LessonStatus.Completed))">@RevisitText(lesson.Status)</button>
        </p>
    </section>

    <h2 class="section-title mt-12 mb-2 text-[1.2rem]">Accuracy</h2>
    <dl class="concept-stats m-0 grid grid-cols-[repeat(auto-fit,minmax(10rem,1fr))] gap-4">
        <div class="panel px-5 py-4 shadow-(--shadow-card)"><dt class="text-[.85rem] text-fg-secondary">In the lesson</dt><dd class="m-0 text-[1.1rem] font-semibold">@concept.LessonCorrect of @concept.LessonAttempts right</dd></div>
        <div class="panel px-5 py-4 shadow-(--shadow-card)"><dt class="text-[.85rem] text-fg-secondary">In review</dt><dd class="m-0 text-[1.1rem] font-semibold">@concept.ReviewCorrect of @concept.ReviewAttempts right</dd></div>
        <div class="panel px-5 py-4 shadow-(--shadow-card)"><dt class="text-[.85rem] text-fg-secondary">Overall</dt><dd class="m-0 text-[1.1rem] font-semibold">@(concept.Accuracy is { } a ? $"{(int)Math.Round(100 * a)}%" : "No answers yet")</dd></div>
    </dl>

    <h2 class="section-title mt-12 mb-2 text-[1.2rem]">Review questions</h2>
    @if (concept.Items.Count == 0)
    {
        <p class="track-meta content-column my-0 text-fg-secondary">No review questions test this concept yet, so it can be seen but not mastered.</p>
    }
    else
    {
        <ul class="concept-items mt-0 mb-2 grid list-none gap-2 p-0">
            @foreach (var item in concept.Items)
            {
                <li class="concept-item panel flex items-center gap-4 px-5 py-3">
                    <span class="item-title flex-1 font-semibold">@item.Question.Title</span>
                    @if (item.Item.Kind == ReviewKind.Pattern) { <small class="item-kind rounded-full bg-surface px-2 py-[.05rem] text-fg-secondary">Pattern</small> }
                    <small class="item-due text-fg-secondary">@DueText(item, learner.AsOf, offset)</small>
                </li>
            }
        </ul>
    }

    <h2 class="section-title mt-12 mb-2 text-[1.2rem]">History</h2>
    @if (concept.History.Count == 0)
    {
        <p class="track-meta content-column my-0 text-fg-secondary">No answers yet.</p>
    }
    else
    {
        <ol class="attempts mt-0 mb-12 grid list-none gap-2 p-0">
            @foreach (var h in concept.History)
            {
                <li class="attempt @(h.Correct ? "correct" : "incorrect") panel flex items-center gap-4 px-5 py-3">
                    <span class="attempt-mark flex-none @(h.Correct ? "text-success" : "text-danger")" aria-hidden="true"><Icon Name="@(h.Correct ? "check" : "cross")" Class="size-6" /></span>
                    <span class="attempt-what grid flex-1 font-semibold">@StepTitle(lesson.Lesson, h.StepId)<small class="font-normal text-fg-secondary">@h.Source · @ConceptText.Day(h.At, offset)</small></span>
                    <span class="attempt-result text-[.85rem] text-fg-secondary">@(h.Correct ? "Correct" : "Incorrect")</span>
                </li>
            }
        </ol>
    }
}

@code {
    [Parameter, EditorRequired] public ContentGraph Content { get; set; } = default!;
    [Parameter, EditorRequired] public string ConceptId { get; set; } = "";
    [Parameter] public EventCallback OnBack { get; set; }

    /// <summary>Open the lesson that teaches the concept; true to replay it (it is finished).</summary>
    [Parameter] public EventCallback<(Lesson Lesson, bool Review)> OnOpenLesson { get; set; }

    private static string TrackTitle(LearnerState learner, ConceptMastery c) =>
        learner.Track(c.Lesson.Lesson.TrackId)?.Track.Title ?? "Back";

    private static string StepTitle(Lesson lesson, string stepId) =>
        lesson.AllSteps().FirstOrDefault(s => s.Id == stepId)?.Title ?? stepId;

    private static string RevisitText(LessonStatus s) => s switch
    {
        LessonStatus.Completed => "Review lesson",
        LessonStatus.InProgress => "Continue lesson",
        LessonStatus.Locked => "Locked",
        _ => "Start lesson",
    };

    private static string DueText(ReviewItemState item, DateTimeOffset now, TimeSpan offset) =>
        !item.IsUnlocked ? "Unlocks when the lesson is finished"
        : item.Card is null ? "Not reviewed yet"
        : item.Card.Due <= now ? "Due now"
        : $"Due {ConceptText.Day(item.Card.Due, offset)}";
}
