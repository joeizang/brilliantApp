@* Connect this device to the household server: where it lives and the one-time code it printed. Once paired, shows where, with a way to forget it. *@
@using Brilliant.Core.Sync
@using Brilliant.Core.Content
@implements IDisposable
@inject PairingService Pairing
@inject SyncService Sync
@inject TimeProvider Clock
@inject IServiceProvider Services

@if (OnBack.HasDelegate)
{
    <div class="crumbs content-column"><button class="link btn-link" @onclick="() => OnBack.InvokeAsync()">← Today</button></div>
}
<h1 class="screen-title content-column mt-6">Sync</h1>

@if (_loading)
{
    <p class="content-column mt-4 text-fg-secondary" role="status">Checking…</p>
}
else if (_paired is { } paired)
{
    <div class="paired content-column mt-4 grid gap-3">
        <p class="paired-status m-0 flex items-center gap-2"><Icon Name="check" Class="icon-draw size-6 text-success" />Paired with <strong class="paired-server">@paired.Server.Authority</strong></p>
        <div class="sync-status grid gap-2" role="status">
            <p class="last-synced m-0">@LastSyncedText(paired)</p>
            @if (Sync.RejectedCount(paired.DeviceId) is var held and > 0)
            {
                <p class="sync-held m-0 text-[.9rem] text-fg-secondary">
                    @held @(held == 1 ? "item" : "items") from this device @(held == 1 ? "is" : "are") too large for the server and @(held == 1 ? "stays" : "stay") on this device only, so other devices won't see @(held == 1 ? "it" : "them").
                </p>
            }
            @if (Sync.Last is { Failure: { } failure })
            {
                <p class="sync-error m-0 text-danger" role="alert">@FailureText(failure)</p>
                @if (Sync.Last.Detail is not null)
                {
                    <p class="sync-detail m-0 text-[.85rem] text-fg-secondary">@Sync.Last.Detail</p>
                }
            }
            @if (_updates is not null)
            {
                <p class="content-status m-0" role="status">@ContentText()</p>
                @if (_updates.Last is { Outcome: ContentUpdateOutcome.Failed, Detail: { } updateDetail })
                {
                    <p class="content-detail m-0 text-[.85rem] text-fg-secondary">@updateDetail</p>
                }
            }
            <div><button class="sync-now primary btn-primary" @onclick="SyncNow" disabled="@(Sync.IsSyncing || _checking)">@(Sync.IsSyncing || _checking ? "Syncing…" : "Sync now")</button></div>
        </div>
        <p class="m-0 text-[.9rem] text-fg-secondary">This device is on the server's list. To disconnect it for good, revoke it on the server; forgetting only clears it here.</p>
        @if (_error is not null)
        {
            <p class="forget-error m-0 text-danger" role="alert">@_error</p>
            @if (_detail is not null)
            {
                <p class="m-0 text-[.85rem] text-fg-secondary">@_detail</p>
            }
        }
        <div><button class="forget btn-secondary" @onclick="Forget">Forget this server</button></div>
    </div>
}
else
{
    <form class="pair-form content-column mt-4 mb-6 grid gap-4" @onsubmit="Pair">
        <p class="m-0 text-fg-secondary">Run <code>docker compose exec server dotnet Brilliant.Server.dll pairing-code</code> on the server for a code, then enter it here.</p>
        <div class="grid gap-1">
            <label class="font-semibold" for="pair-address">Server address</label>
            <input id="pair-address" class="pair-address @InputClass" type="text" inputmode="url" autocapitalize="none" autocorrect="off" spellcheck="false"
                   placeholder="192.168.1.20:8443" @bind="_address" @bind:event="onchange" />
        </div>
        <div class="grid gap-1">
            <label class="font-semibold" for="pair-code">Pairing code</label>
            <input id="pair-code" class="pair-code @InputClass uppercase tracking-widest" type="text" autocapitalize="characters" autocorrect="off" spellcheck="false"
                   placeholder="XXXX-XXXX" maxlength="9" @bind="_code" @bind:event="onchange" />
        </div>
        <div class="grid gap-1">
            <label class="font-semibold" for="pair-name">This device is called</label>
            <input id="pair-name" class="pair-name @InputClass" type="text" maxlength="100" @bind="_deviceName" @bind:event="onchange" />
        </div>
        @if (_error is not null)
        {
            <p class="pair-error m-0 text-danger" role="alert">@_error</p>
            @if (_detail is not null)
            {
                <p class="pair-detail m-0 text-[.85rem] text-fg-secondary">@_detail</p>
            }
        }
        <div><button class="pair-submit primary btn-primary" type="submit" disabled="@_busy">@(_busy ? "Pairing…" : "Pair")</button></div>
    </form>
}

@code {
    private const string InputClass = "box-border w-full rounded-md border border-border bg-surface px-3 py-2 text-[1rem] text-fg transition-shadow duration-150 ease-app focus:ring-2 focus:ring-accent focus:outline-none";

    [Parameter] public EventCallback OnBack { get; set; }

    private bool _loading = true;
    private bool _checking;
    private ContentUpdateService? _updates;   // optional: hosts without a server don't register it
    private bool _busy;
    private DeviceCredentials? _paired;
    private string _address = "";
    private string _code = "";
    private string _deviceName = "";
    private string? _error;
    private string? _detail;

    protected override async Task OnInitializedAsync()
    {
        Sync.StatusChanged += OnStatusChanged;
        _updates = Services.GetService(typeof(ContentUpdateService)) as ContentUpdateService;
        if (_updates is not null) _updates.Changed += OnStatusChanged;
        _deviceName = Services.GetService(typeof(DeviceLabel)) is DeviceLabel label ? label.Name : Environment.MachineName;
        _paired = await Pairing.CurrentAsync();
        _loading = false;
    }

    public void Dispose()
    {
        Sync.StatusChanged -= OnStatusChanged;
        if (_updates is not null) _updates.Changed -= OnStatusChanged;
    }

    // Raised from whichever thread the sync runs on.
    private void OnStatusChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task SyncNow()
    {
        await Sync.SyncAsync();
        if (_updates is null) return;
        _checking = true;
        try { await _updates.CheckAsync(); }
        finally { _checking = false; }
    }

    private string ContentText() => _updates switch
    {
        { PendingVersion: { } pending } => $"Content {pending} downloaded. Restart the app to use it (you're on {_updates.RunningVersion}).",
        { Last.Outcome: ContentUpdateOutcome.Failed } => $"Couldn't check for new content. You're on {_updates.RunningVersion}.",
        { Last: null } => $"Content {_updates!.RunningVersion}.",
        _ => $"Content {_updates!.RunningVersion} is up to date.",
    };

    private string LastSyncedText(DeviceCredentials paired)
    {
        if (Sync.LastSyncedAt(paired.DeviceId) is not { } at) return Sync.IsSyncing ? "Syncing for the first time…" : "Not synced yet.";
        var ago = Clock.GetUtcNow() - at;
        return "Last synced " + (ago < TimeSpan.FromMinutes(1) ? "just now"
            : ago < TimeSpan.FromHours(1) ? $"{(int)ago.TotalMinutes} min ago"
            : ago < TimeSpan.FromDays(1) ? $"{(int)ago.TotalHours} h ago"
            : at.ToLocalTime().ToString("d MMM yyyy, HH:mm")) + ".";
    }

    private static string FailureText(SyncFailure failure) => failure switch
    {
        SyncFailure.Untrusted => "This device doesn't trust the server's certificate. Install the household's certificate authority on it (see docs/https.md), then sync again.",
        SyncFailure.Unreachable => "Couldn't reach the server. Your progress is safe on this device and will sync when it's back.",
        SyncFailure.Unauthorized => "The server no longer accepts this device; it may have been revoked. Forget it here and pair again.",
        SyncFailure.NotPaired => "This device isn't paired with a server.",
        SyncFailure.LocalError => "Couldn't read or write progress on this device while syncing.",
        _ => "The server ran into a problem. Your progress is safe here; try again later.",
    };

    private async Task Pair()
    {
        if (_busy) return;
        _error = _detail = null;
        if (string.IsNullOrWhiteSpace(_address) || string.IsNullOrWhiteSpace(_code))
        {
            _error = "Enter the server's address and the pairing code.";
            return;
        }

        _busy = true;
        try
        {
            var name = string.IsNullOrWhiteSpace(_deviceName) ? "My device" : _deviceName.Trim();
            var outcome = await Pairing.PairAsync(_address, _code, name);
            if (outcome.Credentials is { } credentials)
            {
                _paired = credentials;
                _code = "";
                _ = Sync.SyncAsync();   // start right away; the screen shows how it goes
            }
            else
            {
                _detail = outcome.Detail;
                _error = outcome.Failure switch
                {
                    PairingFailure.BadAddress => "That doesn't look like a server address. Try something like 192.168.1.20:8443 (the server speaks https; http:// addresses aren't used).",
                    PairingFailure.Untrusted => "This device doesn't trust the server's certificate. Install the household's certificate authority on it (see docs/https.md), then try again.",
                    PairingFailure.CodeRejected => "That code didn't work. It may have expired or been used already; ask the server for a new one.",
                    PairingFailure.TooManyAttempts => "Too many tries. Wait a minute and try again.",
                    PairingFailure.CouldNotSave => "The server accepted this device, but it couldn't be remembered here. Revoke it on the server and try again.",
                    PairingFailure.Rejected => "The server refused the request. Check the code and the device name.",
                    _ => "Couldn't reach a Brilliant server there. Check the address and that you're on the same network.",
                };
            }
        }
        finally { _busy = false; }
    }

    private async Task Forget()
    {
        try
        {
            await Pairing.ForgetAsync();
            _paired = null;
            _error = _detail = null;
        }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            _error = "Couldn't forget this server on this device. Try again.";
            _detail = e.GetBaseException().Message;
        }
    }
}
