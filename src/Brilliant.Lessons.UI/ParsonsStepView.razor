@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject StepShortcuts Shortcuts
@inject IJSRuntime JS
@inject ScreenInfo Screen

<article class="parsons-step lesson-step">
    <h2>@(Title ?? Step.Title)</h2>
    <p class="prompt">@Step.Prompt</p>
    <p class="hint-text text-[.95rem] text-fg-secondary" id="@HelpId">
        @if (Screen.IsPhone)
        {
            <text>Put the lines in order and give each the right indentation. Drag a line by its handle <span aria-hidden="true">⠿</span>, or use the arrow buttons to move it and change its indentation.</text>
        }
        else
        {
            <text>Put the lines in order and give each the right indentation. Drag a line, or select it and press
            <kbd>⌥</kbd><kbd>↑</kbd> / <kbd>⌥</kbd><kbd>↓</kbd> to move it and <kbd>⌥</kbd><kbd>←</kbd> / <kbd>⌥</kbd><kbd>→</kbd> to change its indentation.</text>
        }
    </p>

    <ol @ref="_list" class="rows my-4 grid list-none gap-[.4rem] p-0" data-locked="@(Locked ? "true" : "false")" aria-label="Lines of code, in the order you have put them">
        @for (var i = 0; i < _board.Rows.Count; i++)
        {
            var index = i;
            var row = _board.Rows[i];
            <li @key="_board.Rows[i].Piece" @ref="_items[row.Piece]" data-row="@index" class="@RowClass(index)" tabindex="0" draggable="@(Locked ? "false" : "true")"
                aria-describedby="@HelpId" aria-label="@RowLabel(index)"
                @onkeydown="e => KeyDown(index, e)"
                @ondragstart="() => _dragging = index"
                @ondragend="EndDrag"
                @ondragenter="() => _over = index"
                @ondragover="() => { }" @ondragover:preventDefault
                @ondrop="() => Drop(index)" @ondrop:preventDefault>
                <span class="grip flex touch-none items-center justify-center text-code-muted select-none coarse:min-h-(--touch) coarse:min-w-(--touch)" aria-hidden="true">⠿</span>
                <span class="indent inline-block h-px flex-none transition-[width] duration-100 ease-[ease]" style="width:@(row.Level * 2)rem" aria-hidden="true"></span>
                <code class="text min-w-0 flex-1 overflow-x-auto font-mono text-[.9rem] leading-[normal] whitespace-pre select-none">@Step.Lines[row.Piece].Text</code>
                <span class="controls inline-flex gap-1 narrow:w-full narrow:justify-end">
                    <button type="button" class="@ControlButton" tabindex="-1" aria-label="Move up" disabled="@(Locked || index == 0)" @onclick="() => MoveBy(index, -1)">▲</button>
                    <button type="button" class="@ControlButton" tabindex="-1" aria-label="Move down" disabled="@(Locked || index == _board.Rows.Count - 1)" @onclick="() => MoveBy(index, 1)">▼</button>
                    <button type="button" class="@ControlButton" tabindex="-1" aria-label="Outdent" disabled="@(Locked || row.Level == 0)" @onclick="() => IndentBy(index, -1)">⇤</button>
                    <button type="button" class="@ControlButton" tabindex="-1" aria-label="Indent" disabled="@(Locked || row.Level >= _board.MaxLevel)" @onclick="() => IndentBy(index, 1)">⇥</button>
                </span>
                @if (_result is not null && _result.Rows[index] != RowVerdict.Correct)
                {
                    <span class="why basis-full text-[.85rem] text-danger">@(_result.Rows[index] == RowVerdict.WrongIndent ? "Right line, wrong indentation" : "A different line goes here")</span>
                }
            </li>
        }
    </ol>

    @if (_result is null)
    {
        <button class="primary btn-primary" @onclick="Check">@CheckText</button>
    }
    else if (_result.IsCorrect)
    {
        <p class="verdict correct font-semibold text-success" role="status">Correct!</p>
        <button class="primary btn-primary" @onclick="() => OnContinue.InvokeAsync()">Continue</button>
    }
    else
    {
        <p class="verdict incorrect font-semibold text-danger" role="status">Not quite: @_result.CorrectCount of @_board.Rows.Count lines are right. Have another go.</p>
        <button class="primary btn-primary" @onclick="TryAgain">Try again</button>
    }
</article>

@code {
    /// <summary>What the learner submitted: the arrangement (line + indentation, top to bottom) and the verdict.</summary>
    public sealed record Attempt(ParsonsResult Result, IReadOnlyList<ParsonsPlacement> Arrangement);

    [Parameter, EditorRequired] public ParsonsStep Step { get; set; } = default!;

    /// <summary>Shown instead of the step's title: Practice shows a problem as "Problem", so the title can't name its pattern.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>The label of the button that checks the answer. An interview says "Submit": the answer is taken without a verdict.</summary>
    [Parameter] public string CheckText { get; set; } = "Check";

    /// <summary>The arrangement to begin with: an interview restores the learner's from before switching problems. Ignored if it doesn't fit the step.</summary>
    [Parameter] public IReadOnlyList<ParsonsPlacement>? Initial { get; set; }

    /// <summary>Raised after each move or indent, with the whole arrangement.</summary>
    [Parameter] public EventCallback<IReadOnlyList<ParsonsPlacement>> OnChanged { get; set; }

    /// <summary>Raised each time the learner checks their arrangement (correct or not).</summary>
    [Parameter] public EventCallback<Attempt> OnAnswered { get; set; }

    /// <summary>Raised when the learner continues after a correct arrangement.</summary>
    [Parameter] public EventCallback OnContinue { get; set; }

    private ParsonsBoard _board = default!;
    private readonly Dictionary<int, ElementReference> _items = [];
    private ParsonsResult? _result;
    private int? _dragging;
    private int? _over;
    private int? _refocus;   // the line that was just moved and should keep keyboard focus

    private bool Locked => _result is not null;
    private string HelpId => $"{Step.Id}-help";

    private IDisposable? _shortcuts;
    private ElementReference _list;
    private IJSObjectReference? _touch;
    private DotNetObjectReference<ParsonsStepView>? _self;

    protected override void OnInitialized()
    {
        _board = (Initial is null ? null : ParsonsBoard.Restore(Step, Initial)) ?? ParsonsBoard.Shuffled(Step);
        _shortcuts = Shortcuts.Subscribe(OnShortcut);
        Screen.Changed += OnScreenChanged;
    }

    private void OnScreenChanged() => _ = InvokeAsync(StateHasChanged);

    private Task OnShortcut(StepShortcut s) => InvokeAsync(async () =>
    {
        switch (s.Command)
        {
            case StepCommand.Run or StepCommand.Advance when _result is null:
                if (true) await Check();
                break;
            case StepCommand.Advance when _result is { IsCorrect: true }:
                await OnContinue.InvokeAsync();
                return;
            case StepCommand.Advance:
                TryAgain();
                break;
        }
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        _shortcuts?.Dispose();
        Screen.Changed -= OnScreenChanged;
        try
        {
            if (_touch is not null)
            {
                await _touch.InvokeVoidAsync("detach", _list);
                await _touch.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }   // the app is shutting down
        _self?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // A finger can't start the browser's own drag, so the grips are followed by hand (parsons-touch.js). The buttons work without it.
            try
            {
                _touch = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Brilliant.Lessons.UI/parsons-touch.js");
                _self = DotNetObjectReference.Create(this);
                await _touch.InvokeVoidAsync("attach", _list, _self);
            }
            catch (Exception e) when (e is not OperationCanceledException) { }
        }

        // Moving a keyed element in the DOM drops its focus, so give it back to the line the learner is working on.
        if (_refocus is { } piece && _items.TryGetValue(piece, out var item))
        {
            _refocus = null;
            await item.FocusAsync();
        }
    }

    private const string RowBase = "row relative flex data-[touch-drag=true]:z-10 data-[touch-drag=true]:opacity-90 data-[touch-drag=true]:shadow-lg data-[touch-over=true]:shadow-[0_-3px_0_var(--accent)] cursor-grab flex-wrap items-center gap-[.6rem] rounded-sm border border-hairline bg-code-bg px-3 py-[.4rem] text-code-fg transition-shadow duration-150 ease-app focus:outline-none";
    private const string ControlButton = "min-h-8 min-w-8 coarse:min-h-(--touch) coarse:min-w-(--touch) cursor-pointer rounded-sm border border-border bg-surface px-2 py-0 font-inherit leading-none text-inherit disabled:cursor-default disabled:opacity-35";

    // The marks are exclusive, in the order they win: a checked row shows its verdict, else the drop target shows where the
    // dragged line will land, else keyboard focus shows a ring.
    private string RowClass(int index)
    {
        var classes = new List<string> { RowBase };
        if (_result is not null) classes.Add(_result.Rows[index] == RowVerdict.Correct ? "right ring-2 ring-success" : "wrong ring-2 ring-danger");
        else if (_dragging is not null && _dragging != index && _over == index) classes.Add("over shadow-[0_-3px_0_var(--accent)]");
        else classes.Add("focus:ring-2 focus:ring-accent");
        if (_dragging == index) classes.Add("dragging opacity-40");
        return string.Join(' ', classes);
    }

    private string RowLabel(int index) =>
        $"Line {index + 1} of {_board.Rows.Count}, indented {_board.Rows[index].Level} levels: {Step.Lines[_board.Rows[index].Piece].Text}";

    private void MoveBy(int index, int delta)
    {
        if (Locked) return;
        var piece = _board.Rows[index].Piece;
        if (_board.Move(index, index + delta)) Moved(piece);
    }

    private void IndentBy(int index, int delta)
    {
        if (Locked) return;
        var piece = _board.Rows[index].Piece;
        if (_board.Indent(index, delta)) Moved(piece);
    }

    // A line has moved or changed indentation: keep keyboard focus on it, and report the arrangement.
    private void Moved(int? piece)
    {
        _refocus = piece;
        _ = OnChanged.InvokeAsync(_board.Rows.ToList());
    }

    private void KeyDown(int index, KeyboardEventArgs e)
    {
        if (!e.AltKey) return;
        switch (e.Key)
        {
            case "ArrowUp": MoveBy(index, -1); break;
            case "ArrowDown": MoveBy(index, 1); break;
            case "ArrowLeft": IndentBy(index, -1); break;
            case "ArrowRight": IndentBy(index, 1); break;
        }
    }

    private void Drop(int target)
    {
        var from = _dragging;
        EndDrag();
        if (Locked || from is null) return;
        var piece = _board.Rows[from.Value].Piece;
        if (_board.Move(from.Value, target)) Moved(piece);
    }

    /// <summary>Called by parsons-touch.js when a finger lets go of a line dragged from row <paramref name="from"/> over row <paramref name="to"/>.</summary>
    [JSInvokable]
    public Task MoveTo(int from, int to) => InvokeAsync(() =>
    {
        if (Locked || from < 0 || to < 0 || from >= _board.Rows.Count || to >= _board.Rows.Count) return;
        if (_board.Move(from, to)) Moved(null);
        StateHasChanged();
    });

    private void EndDrag() => (_dragging, _over) = (null, null);

    private async Task Check()
    {
        _result = _board.Check();
        await OnAnswered.InvokeAsync(new Attempt(_result, _board.Rows.ToList()));
    }

    // The learner keeps their arrangement and fixes what's wrong.
    private void TryAgain() => _result = null;
}
