@* The bottom tab bar for windows too narrow for the sidebar (phones and small tablets). The same places as the sidebar's top items;
   Flagged steps is reached from Tracks. Visibility is the stylesheet's (below the `wide` breakpoint), so it needs no script. *@
@using Brilliant.Core.Progress
@inject ProgressRecorder Recorder

@{
    var due = Recorder.Project(Content).Queue.Items.Count;
}
<nav class="phone-nav fixed inset-x-0 bottom-0 z-20 grid grid-cols-4 border-t border-hairline bg-surface-raised/95 backdrop-blur-[1.25rem] wide:hidden" aria-label="Main">
    <button class="@Tab(Place.Today)" aria-current="@Current(Place.Today)" @onclick="() => OnOpenToday.InvokeAsync()"><span aria-hidden="true">🏠</span>Today</button>
    <button class="@Tab(Place.Tracks)" aria-current="@Current(Place.Tracks)" @onclick="() => OnOpenTracks.InvokeAsync()"><span aria-hidden="true">📚</span>Tracks</button>
    <button class="@Tab(Place.Review)" aria-current="@Current(Place.Review)" @onclick="() => OnOpenReview.InvokeAsync()">
        <span class="relative" aria-hidden="true">🔁
            @if (due > 0)
            {
                <small class="due-count absolute -top-1 left-4 min-w-[1.2rem] rounded-full bg-accent px-1 text-center text-[.7rem] font-bold text-on-accent">@due</small>
            }
        </span>
        <span>Review</span>
        @if (due > 0)
        {
            <span class="sr-only">(@due due)</span>
        }
    </button>
    <button class="@Tab(Place.Sync)" aria-current="@Current(Place.Sync)" @onclick="() => OnOpenSync.InvokeAsync()"><span aria-hidden="true">🔄</span>Sync</button>
</nav>

@code {
    public enum Place { Today, Tracks, Review, Sync, Other }

    [Parameter, EditorRequired] public ContentGraph Content { get; set; } = default!;

    /// <summary>Which tab to mark as the current one; <see cref="Place.Other"/> (a track, a concept, flagged steps) marks none.</summary>
    [Parameter] public Place Active { get; set; }

    [Parameter] public EventCallback OnOpenToday { get; set; }
    [Parameter] public EventCallback OnOpenTracks { get; set; }
    [Parameter] public EventCallback OnOpenReview { get; set; }
    [Parameter] public EventCallback OnOpenSync { get; set; }

    private string? Current(Place place) => place == Active ? "page" : null;

    private string Tab(Place place) =>
        "tab flex min-h-14 cursor-pointer flex-col items-center justify-center gap-0.5 border-0 bg-transparent px-1 text-[.75rem] font-medium " +
        (place == Active ? "current text-accent" : "text-fg-secondary");
}
