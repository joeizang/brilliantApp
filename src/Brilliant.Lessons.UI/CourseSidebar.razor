@using Brilliant.Core.Progress
@inject ProgressRecorder Recorder

@{
    var learner = Recorder.Project(Content);
    var due = learner.Queue.Items.Count;
}
<nav class="sidebar" aria-label="Course">
    <button class="side-today @(TodayActive ? "current" : "")" aria-current="@(TodayActive ? "page" : null)" @onclick="() => OnOpenToday.InvokeAsync()">
        <span>Today</span>
        @if (learner.Today.Streak > 0)
        {
            <small class="streak-count" aria-label="@learner.Today.Streak day streak">🔥 @learner.Today.Streak</small>
        }
    </button>
    <button class="side-review @(ReviewActive ? "current" : "")" aria-current="@(ReviewActive ? "page" : null)" @onclick="() => OnOpenReview.InvokeAsync()">
        <span>Review</span>
        @if (due > 0)
        {
            <small class="due-count" aria-label="@due due">@due</small>
        }
    </button>
    @foreach (var track in learner.Tracks)
    {
        <section class="side-track">
            <button class="side-track-title @(track.Track.Id == CurrentTrack?.Id ? "current" : "")" @onclick="() => OnOpenTrack.InvokeAsync(track.Track)">
                @track.Track.Title
                <small>@track.CompletedLessons / @track.TotalLessons</small>
            </button>
            <ol>
                @foreach (var l in track.Lessons)
                {
                    <li>
                        <button class="side-lesson @l.Status.ToString().ToLowerInvariant() @(l.Lesson.Id == CurrentLesson?.Id ? "current" : "")"
                                disabled="@(l.Status == LessonStatus.Locked)"
                                aria-current="@(l.Lesson.Id == CurrentLesson?.Id ? "page" : null)"
                                @onclick="() => OnOpenLesson.InvokeAsync((track.Track, l.Lesson, l.Status == LessonStatus.Completed && l.NewStepCount == 0))">
                            <span class="status" aria-hidden="true">@Icon(l.Status)</span>
                            <span>@l.Lesson.Title</span>
                        </button>
                    </li>
                }
            </ol>
        </section>
    }
</nav>

@code {
    [Parameter, EditorRequired] public ContentGraph Content { get; set; } = default!;
    [Parameter] public Track? CurrentTrack { get; set; }
    [Parameter] public Lesson? CurrentLesson { get; set; }
    [Parameter] public EventCallback<Track> OnOpenTrack { get; set; }
    [Parameter] public bool ReviewActive { get; set; }
    [Parameter] public bool TodayActive { get; set; }
    [Parameter] public EventCallback OnOpenToday { get; set; }
    [Parameter] public EventCallback OnOpenReview { get; set; }

    /// <summary>A lesson was picked: its track, the lesson, and whether to replay it (it is already complete).</summary>
    [Parameter] public EventCallback<(Track Track, Lesson Lesson, bool Review)> OnOpenLesson { get; set; }

    private static string Icon(LessonStatus s) => s switch
    {
        LessonStatus.Completed => "✓",
        LessonStatus.Locked => "🔒",
        LessonStatus.InProgress => "◐",
        _ => "○",
    };
}
