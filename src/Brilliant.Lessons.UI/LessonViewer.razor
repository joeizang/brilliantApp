@using Brilliant.Core.Progress
@using Brilliant.Core.Review
@implements IDisposable
@inject ProgressRecorder Recorder
@inject StepShortcuts Shortcuts
@inject ScreenInfo Screen

<div class="lesson-bar content-column mt-2 flex items-center gap-4 text-[.9rem]">
    <button class="link btn-link" @onclick="() => OnExit.InvokeAsync()"><Icon Name="back" Class="size-5" /> Back</button>
    @if (Review)
    {
        <span class="review-badge rounded-full bg-warn px-3 py-[.2rem]">Review mode: your progress won't change</span>
    }
</div>
<h1 class="lesson-title content-column mt-2 mb-0">@Lesson.Title</h1>

@{
    var progress = LearnerStateProjector.ProjectLesson(Lesson, Recorder.Log.ReadAll());
    var total = Lesson.Steps.Count;
    var done = Review ? _reviewIndex : progress.CompletedCount;
    var step = Review ? Lesson.Steps.ElementAtOrDefault(_reviewIndex) : progress.NextStep;
    var newSteps = Review ? 0 : progress.NewSteps.Count;
}

<div class="lesson-progress content-column mt-2 text-[.9rem] text-fg-secondary" role="progressbar" aria-valuemin="0" aria-valuemax="@total" aria-valuenow="@done">
    <div class="bar progress-bar mb-2"><div class="fill progress-fill" style="width:@(total == 0 ? 0 : 100 * done / total)%"></div></div>
    <span>@(step is null ? (Review ? "Review finished" : "Lesson complete") : newSteps > 0 ? $"{newSteps} new {(newSteps == 1 ? "step" : "steps")} since you finished" : $"{total - done} of {total} steps remaining")</span>
</div>

@if (!Review && _testing)
{
    <TestOutView Lesson="Lesson" OnPassed="PassedTestOut" OnMissed="() => _testing = false" />
}
else if (step is not null)
{
    var shown = Shown(step);
    @if (!Review && LessonTestOut.IsOffered(progress))
    {
        <div class="testout-offer content-column mt-4 flex flex-wrap items-center gap-3 rounded-lg border border-hairline bg-surface-raised px-4 py-3 text-[.95rem]">
            <span class="flex-1">Already know this? Answer @LessonTestOut.Select(Lesson).Count questions from the lesson and skip it. A miss costs nothing.</span>
            <button class="secondary btn-secondary" @onclick="() => _testing = true">I know this — test me</button>
        </div>
    }
    <div @key="step.Id">
        @if ((step.LargeScreenPreferred && Screen.IsPhone) || Screen.RequiresPhoneAlternative(step))
        {
            <div class="large-screen-note content-column mt-4 rounded-lg border border-hairline bg-surface-raised px-4 py-3 text-[.95rem]" role="note">
                @if (shown != step)
                {
                    <span>This is the tap-friendly version of the step.</span>
                    @if (!Screen.RequiresPhoneAlternative(step))
                    {
                        <button class="link btn-link ml-2" @onclick="() => _useAlternative = false">Switch back</button>
                    }
                }
                else
                {
                    <span>This step is best on a larger screen, where you can type the code.</span>
                    @if (step.PhoneAlternative is not null)
                    {
                        <button class="link btn-link ml-2" @onclick="() => _useAlternative = true">Try the @(step.PhoneAlternative is ParsonsStep ? "arrange-the-lines" : "fill-in-the-blank") version</button>
                    }
                }
            </div>
        }
        @switch (shown)
        {
            case ExplainStep explain:
                <ExplainStepView Step="explain" />
                <div class="step-actions content-column pb-6"><button class="primary btn-primary" @onclick="() => Complete(step)">Continue</button></div>
                break;
            case TraceStep trace:
                <TraceStepView Step="trace" />
                <div class="step-actions content-column pb-6"><button class="primary continue btn-primary" @onclick="() => Complete(step)">Continue</button></div>
                break;
            case ChoiceStep choice:
                <ChoiceStepView Step="choice"
                                OnAnswered="r => { if (!Review) Recorder.StepAnswered(Lesson.Id, step.Id, r.IsCorrect, r.Selected); }"
                                OnContinue="() => Complete(step)" />
                break;
            case PredictOutputStep predict:
                <PredictOutputStepView Step="predict" OnAnswered="a => Answered(step, predict, a)" OnContinue="() => Complete(step)" />
                break;
            case LoweredStep lowered:
                <LoweredStepView Step="lowered" OnAnswered="a => Answered(step, lowered, a)" OnContinue="() => Complete(step)" />
                break;
            case WriteCodeStep write:
                <WriteCodeStepView Step="write" OnSubmitted="s => Submitted(step, write, s)" OnContinue="() => Complete(step)" />
                break;
            case FillBlankStep fill:
                <FillBlankStepView Step="fill" OnAnswered="a => Answered(step, fill, a)" OnContinue="() => Complete(step)" />
                break;
            case ParsonsStep parsons:
                <ParsonsStepView Step="parsons" OnAnswered="a => Answered(step, parsons, a)" OnContinue="() => Complete(step)" />
                break;
        }
        <HintLadder @key="shown.Id" Hints="shown.Hints" Walkthrough="shown.Walkthrough" OnRevealed="level => Hinted(step, level)" />
        <FlagStep LessonId="@Lesson.Id" StepId="@step.Id" />
    </div>
}
else
{
    <p class="lesson-done content-column mt-12 mb-12 text-[1.3rem]">@(Review ? "That's the whole lesson." : progress.TestedOut && !progress.CompletionRecorded ? "You tested out of this lesson. 🎉" : "You've finished this lesson. 🎉")</p>
    <div class="step-actions content-column pb-6"><button class="primary btn-primary" @onclick="Finish">@(FinishedText ?? "Back to track")</button></div>
}

@code {
    [Parameter, EditorRequired] public Lesson Lesson { get; set; } = default!;

    /// <summary>Replays the lesson from the start without recording anything, so completion is untouched.</summary>
    [Parameter] public bool Review { get; set; }

    [Parameter] public EventCallback OnExit { get; set; }

    /// <summary>Raised by the button on the finished screen, and by Return there (the Back link raises <see cref="OnExit"/>), so a daily session can tell "done" from "leaving". Falls back to <see cref="OnExit"/>.</summary>
    [Parameter] public EventCallback OnFinished { get; set; }

    /// <summary>The label of the button on the finished screen.</summary>
    [Parameter] public string? FinishedText { get; set; }

    /// <summary>Raised after a step is completed, so whatever shows progress elsewhere (the sidebar) can refresh.</summary>
    [Parameter] public EventCallback OnProgress { get; set; }

    private int _reviewIndex;
    private IDisposable? _shortcuts;
    private bool _useAlternative;
    private bool _testing;

    protected override void OnInitialized()
    {
        _shortcuts = Shortcuts.Subscribe(OnShortcut);
        Screen.Changed += OnScreenChanged;
    }

    public void Dispose()
    {
        _shortcuts?.Dispose();
        Screen.Changed -= OnScreenChanged;
    }

    private void OnScreenChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// What the learner is looking at for <paramref name="step"/>: the step itself, or on a phone, if they chose it, its tap-friendly alternative.
    /// Either way the work counts for <paramref name="step"/> (events, hints, flags, completion), so nothing about progress depends on the device.
    /// </summary>
    private Step Shown(Step step) => Screen.RequiresPhoneAlternative(step) ? Screen.Present(step) : _useAlternative && Screen.IsPhone && step.PhoneAlternative is { } alt ? alt : step;

    private Step? CurrentStep =>
        Review ? Lesson.Steps.ElementAtOrDefault(_reviewIndex) : LearnerStateProjector.ProjectLesson(Lesson, Recorder.Log.ReadAll()).NextStep;

    // Steps that have nothing to check (explanations, the finished screen) are moved on from here; the others handle Return themselves.
    private Task OnShortcut(StepShortcut s) => InvokeAsync(async () =>
    {
        switch (s.Command)
        {
            case StepCommand.Advance when CurrentStep is null:
                await Finish();
                return;
            case StepCommand.Advance when CurrentStep is ExplainStep or TraceStep:
                await Complete(CurrentStep);
                break;
        }
        StateHasChanged();
    });

    private async Task PassedTestOut()
    {
        _testing = false;
        await OnProgress.InvokeAsync();
    }

    private Task Finish() => (OnFinished.HasDelegate ? OnFinished : OnExit).InvokeAsync();

    private void Hinted(Step step, int level)
    {
        if (!Review) Recorder.HintUsed(Lesson.Id, step.Id, level);
    }

    private void Answered(Step owner, PredictOutputStep step, PredictOutputStepView.Attempt a)
    {
        if (Review) return;
        if (a.Response is not null) Recorder.StepAnswered(Lesson.Id, owner.Id, a.Result.IsCorrect, a.Response);
        else Recorder.StepAnswered(Lesson.Id, owner.Id, a.Result.IsCorrect, [a.Selected!.Value]);
    }

    private void Answered(Step owner, LoweredStep step, PredictOutputStepView.Attempt a)
    {
        if (Review) return;
        if (a.Response is not null) Recorder.StepAnswered(Lesson.Id, owner.Id, a.Result.IsCorrect, a.Response);
        else Recorder.StepAnswered(Lesson.Id, owner.Id, a.Result.IsCorrect, [a.Selected!.Value]);
    }

    private void Answered(Step owner, FillBlankStep step, FillBlankStepView.Attempt a)
    {
        if (!Review) Recorder.StepAnswered(Lesson.Id, owner.Id, a.Result.IsCorrect, a.Responses);
    }

    private void Answered(Step owner, ParsonsStep step, ParsonsStepView.Attempt a)
    {
        if (!Review) Recorder.StepAnswered(Lesson.Id, owner.Id, a.Result.IsCorrect, a.Arrangement);
    }

    private void Submitted(Step owner, WriteCodeStep step, WriteCodeStepView.Submission s)
    {
        if (!Review) Recorder.CodeSubmitted(Lesson.Id, owner.Id, s.Code, s.Result.PassedCount, step.Tests.Count);
    }

    private async Task Complete(Step step)
    {
        _useAlternative = false;
        if (Review) _reviewIndex++;
        else Recorder.CompleteStep(Lesson, step.Id);
        await OnProgress.InvokeAsync();
    }
}
