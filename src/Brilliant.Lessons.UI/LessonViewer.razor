@using Brilliant.Core.Progress
@implements IDisposable
@inject ProgressRecorder Recorder
@inject StepShortcuts Shortcuts

<div class="lesson-bar">
    <button class="link" @onclick="() => OnExit.InvokeAsync()">← Back</button>
    @if (Review)
    {
        <span class="review-badge">Review mode: your progress won't change</span>
    }
</div>
<h1 class="lesson-title">@Lesson.Title</h1>

@{
    var progress = LearnerStateProjector.ProjectLesson(Lesson, Recorder.Log.ReadAll());
    var total = Lesson.Steps.Count;
    var done = Review ? _reviewIndex : progress.CompletedCount;
    var step = Review ? Lesson.Steps.ElementAtOrDefault(_reviewIndex) : progress.NextStep;
    var newSteps = Review ? 0 : progress.NewSteps.Count;
}

<div class="lesson-progress" role="progressbar" aria-valuemin="0" aria-valuemax="@total" aria-valuenow="@done">
    <div class="bar"><div class="fill" style="width:@(total == 0 ? 0 : 100 * done / total)%"></div></div>
    <span>@(step is null ? (Review ? "Review finished" : "Lesson complete") : newSteps > 0 ? $"{newSteps} new {(newSteps == 1 ? "step" : "steps")} since you finished" : $"{total - done} of {total} steps remaining")</span>
</div>

@if (step is not null)
{
    <div @key="step.Id">
        @switch (step)
        {
            case ExplainStep explain:
                <ExplainStepView Step="explain" />
                <div class="step-actions"><button class="primary" @onclick="() => Complete(step)">Continue</button></div>
                break;
            case ChoiceStep choice:
                <ChoiceStepView Step="choice"
                                OnAnswered="r => { if (!Review) Recorder.StepAnswered(Lesson.Id, choice.Id, r.IsCorrect, r.Selected); }"
                                OnContinue="() => Complete(step)" />
                break;
            case PredictOutputStep predict:
                <PredictOutputStepView Step="predict" OnAnswered="a => Answered(predict, a)" OnContinue="() => Complete(step)" />
                break;
            case WriteCodeStep write:
                <WriteCodeStepView Step="write" OnSubmitted="s => Submitted(write, s)" OnContinue="() => Complete(step)" />
                break;
            case FillBlankStep fill:
                <FillBlankStepView Step="fill" OnAnswered="a => Answered(fill, a)" OnContinue="() => Complete(step)" />
                break;
            case ParsonsStep parsons:
                <ParsonsStepView Step="parsons" OnAnswered="a => Answered(parsons, a)" OnContinue="() => Complete(step)" />
                break;
        }
    </div>
}
else
{
    <p class="lesson-done">@(Review ? "That's the whole lesson." : "You've finished this lesson. 🎉")</p>
    <div class="step-actions"><button class="primary" @onclick="() => OnExit.InvokeAsync()">Back to track</button></div>
}

@code {
    [Parameter, EditorRequired] public Lesson Lesson { get; set; } = default!;

    /// <summary>Replays the lesson from the start without recording anything, so completion is untouched.</summary>
    [Parameter] public bool Review { get; set; }

    [Parameter] public EventCallback OnExit { get; set; }

    /// <summary>Raised after a step is completed, so whatever shows progress elsewhere (the sidebar) can refresh.</summary>
    [Parameter] public EventCallback OnProgress { get; set; }

    private int _reviewIndex;
    private IDisposable? _shortcuts;

    protected override void OnInitialized() => _shortcuts = Shortcuts.Subscribe(OnShortcut);

    public void Dispose() => _shortcuts?.Dispose();

    private Step? CurrentStep =>
        Review ? Lesson.Steps.ElementAtOrDefault(_reviewIndex) : LearnerStateProjector.ProjectLesson(Lesson, Recorder.Log.ReadAll()).NextStep;

    // Steps that have nothing to check (explanations, the finished screen) are moved on from here; the others handle Return themselves.
    private Task OnShortcut(StepShortcut s) => InvokeAsync(async () =>
    {
        switch (s.Command)
        {
            case StepCommand.Advance when CurrentStep is null:
                await OnExit.InvokeAsync();
                return;
            case StepCommand.Advance when CurrentStep is ExplainStep explain:
                await Complete(explain);
                break;
        }
        StateHasChanged();
    });

    private void Answered(PredictOutputStep step, PredictOutputStepView.Attempt a)
    {
        if (Review) return;
        if (a.Response is not null) Recorder.StepAnswered(Lesson.Id, step.Id, a.Result.IsCorrect, a.Response);
        else Recorder.StepAnswered(Lesson.Id, step.Id, a.Result.IsCorrect, [a.Selected!.Value]);
    }

    private void Answered(FillBlankStep step, FillBlankStepView.Attempt a)
    {
        if (!Review) Recorder.StepAnswered(Lesson.Id, step.Id, a.Result.IsCorrect, a.Responses);
    }

    private void Answered(ParsonsStep step, ParsonsStepView.Attempt a)
    {
        if (!Review) Recorder.StepAnswered(Lesson.Id, step.Id, a.Result.IsCorrect, a.Arrangement);
    }

    private void Submitted(WriteCodeStep step, WriteCodeStepView.Submission s)
    {
        if (!Review) Recorder.CodeSubmitted(Lesson.Id, step.Id, s.Code, s.Result.PassedCount, step.Tests.Count);
    }

    private async Task Complete(Step step)
    {
        if (Review) _reviewIndex++;
        else Recorder.CompleteStep(Lesson, step.Id);
        await OnProgress.InvokeAsync();
    }
}
