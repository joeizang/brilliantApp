@* Review: the questions FSRS says are due, one at a time. Each first answer is recorded as a ReviewAnswered event. *@
@using Brilliant.Core.Progress
@using Brilliant.Core.Python
@using Brilliant.Core.Review
@inject ProgressRecorder Recorder

<div class="review-bar">
    <button class="link" @onclick="() => OnExit.InvokeAsync()">← Back</button>
</div>
<h1 class="review-title">Review</h1>

@if (_current is { } item)
{
    <div class="review-progress" role="progressbar" aria-valuemin="0" aria-valuemax="@_queue.Count" aria-valuenow="@_index">
        <div class="bar"><div class="fill" style="width:@(100 * _index / _queue.Count)%"></div></div>
        <span>@(_index + 1) of @_queue.Count</span>
    </div>

    <div @key="item.Item.Id">
        @if (item.Item.Kind != ReviewKind.Concept)
        {
            <span class="review-kind">@(item.Item.Kind == ReviewKind.Pattern ? "Pattern" : "Re-solve")</span>
        }
        @switch (item.Question)
        {
            case ChoiceStep choice:
                <ChoiceStepView Step="choice" OnAnswered="r => Answered(item, r.IsCorrect)" OnContinue="Next" />
                break;
            case PredictOutputStep predict:
                <PredictOutputStepView Step="predict" OnAnswered="a => Answered(item, a.Result.IsCorrect)" OnContinue="Next" />
                break;
            case FillBlankStep fill:
                <FillBlankStepView Step="fill" OnAnswered="a => Answered(item, a.Result.IsCorrect)" OnContinue="Next" />
                break;
            case ParsonsStep parsons:
                <ParsonsStepView Step="parsons" OnAnswered="a => Answered(item, a.Result.IsCorrect)" OnContinue="Next" />
                break;
            case WriteCodeStep write:
                <WriteCodeStepView Step="write" DraftKey="@DraftKey(item)" OnSubmitted="s => Answered(item, s.Result.Status == TestRunStatus.Passed)" OnContinue="Next" />
                break;
            default:
                <p>This kind of question can't be reviewed here yet.</p>
                <div class="review-actions"><button class="primary" @onclick="Next">Skip</button></div>
                break;
        }
        <HintLadder Hints="item.Question.Hints" Initial="item.AttemptHints" Caption="A hint makes this come back sooner." OnRevealed="level => Hinted(item, level)" />
        @if (_scheduled is { } due)
        {
            <p class="review-next" role="status">You'll see this again @Describe(due - Recorder.Now).</p>
        }
    </div>
}
else
{
    <p class="review-done">@(_waiting > 0 ? "That's all for today." : _queue.Count == 0 && _nextDue is null ? "Nothing to review yet. Finish a lesson and its questions will show up here." : "You're all caught up. 🎉")</p>
    @if (_waiting > 0)
    {
        <p class="review-next">@_waiting more @(_waiting == 1 ? "is" : "are") waiting. They'll be in tomorrow's queue, so a missed day never piles up.</p>
    }
    else if (_nextDue is { } next)
    {
        <p class="review-next">Next review @Describe(next - Recorder.Now).</p>
    }
    <div class="review-actions"><button class="primary" @onclick="Finish">@(FinishedText ?? "Back to tracks")</button></div>
}

@code {
    [Parameter, EditorRequired] public ContentGraph Content { get; set; } = default!;
    [Parameter] public EventCallback OnExit { get; set; }

    /// <summary>Raised by the button at the end of the queue (the Back link raises <see cref="OnExit"/>), so a daily session can tell "done" from "leaving". Falls back to <see cref="OnExit"/>.</summary>
    [Parameter] public EventCallback OnFinished { get; set; }

    /// <summary>The label of the button at the end of the queue.</summary>
    [Parameter] public string? FinishedText { get; set; }

    /// <summary>Raised after an answer is recorded, so whatever shows the due count elsewhere (the sidebar) can refresh.</summary>
    [Parameter] public EventCallback OnProgress { get; set; }

    private IReadOnlyList<ReviewItemState> _queue = [];
    private int _index;
    private DateTimeOffset _shownAt;
    private bool _recorded;
    private int _hintsUsed;
    private DateTimeOffset? _scheduled;
    private DateTimeOffset? _nextDue;
    private int _waiting;

    private ReviewItemState? _current => _index < _queue.Count ? _queue[_index] : null;

    protected override void OnInitialized()
    {
        _queue = Recorder.Project(Content).Queue.Items;
        Show();
    }

    private void Show()
    {
        (_recorded, _hintsUsed, _scheduled, _shownAt) = (false, _current?.AttemptHints ?? 0, null, Recorder.Now);
        (_nextDue, _waiting) = _current is null ? Finished() : (null, 0);
    }

    // Only the first answer to an item counts: retrying is practice, not a better memory.
    private async Task Answered(ReviewItemState item, bool correct)
    {
        if (_recorded) return;
        _recorded = true;
        Recorder.ReviewAnswered(item, correct, item.HintsBefore(_hintsUsed), Recorder.Now - _shownAt);
        _scheduled = Recorder.Project(Content).Reviews.First(r => r.Item.Id == item.Item.Id).Card?.Due;
        await OnProgress.InvokeAsync();
    }

    // Hints count against the rating only if they were asked for before the first answer; after that the question is practice.
    private void Hinted(ReviewItemState item, int level)
    {
        if (_recorded) return;
        _hintsUsed = Math.Max(_hintsUsed, level);
        Recorder.HintUsed(item.Lesson.Id, item.Item.StepId, level, item.Item.Id);
    }

    // A review attempt keeps its own draft, apart from the lesson's. Counting answers in the key means an interrupted attempt resumes,
    // while the next due attempt (after this one was answered) starts again from the starter.
    private static string DraftKey(ReviewItemState item) => $"review.{item.Item.Id}.{item.Answers}";

    private Task Finish() => (OnFinished.HasDelegate ? OnFinished : OnExit).InvokeAsync();

    private void Next()
    {
        _index++;
        Show();
    }

    // What to tell the learner at the end of the queue: reviews held back by today's cap, or else when the next one is due.
    private (DateTimeOffset? NextDue, int Waiting) Finished()
    {
        var state = Recorder.Project(Content);
        var next = state.Reviews
            .Where(r => r.IsUnlocked && r.Card is not null && r.Card.Due > state.AsOf)
            .Select(r => (DateTimeOffset?)r.Card!.Due)
            .Min();
        return (next, state.Queue.Waiting);
    }

    private static string Describe(TimeSpan wait) =>
        wait < TimeSpan.FromHours(1) ? "within the hour"
        : wait < TimeSpan.FromDays(1) ? $"in {(int)wait.TotalHours} hours"
        : $"in {(int)Math.Round(wait.TotalDays)} {((int)Math.Round(wait.TotalDays) == 1 ? "day" : "days")}";
}
