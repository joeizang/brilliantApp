@* Review: the questions FSRS says are due, one at a time. Each first answer is recorded as a ReviewAnswered event. *@
@using Brilliant.Core.Practice
@using Brilliant.Core.Progress
@using Brilliant.Core.Code
@using Brilliant.Core.Review
@implements IDisposable
@inject ProgressRecorder Recorder
@inject ScreenInfo Screen

<div class="review-bar content-column mt-2 flex items-center gap-4 text-[.9rem]">
    <button class="link btn-link" @onclick="() => OnExit.InvokeAsync()"><Icon Name="back" Class="size-5" /> Back</button>
</div>
<h1 class="review-title content-column mt-2 mb-0">Review</h1>

@if (_current is { } item)
{
    <div class="review-progress content-column mt-2 text-[.9rem]" role="progressbar" aria-valuemin="0" aria-valuemax="@_queue.Count" aria-valuenow="@_index">
        <div class="bar progress-bar mb-2"><div class="fill progress-fill" style="width:@(100 * _index / _queue.Count)%"></div></div>
        <span>@(_index + 1) of @_queue.Count</span>
    </div>

    <div @key="item.Item.Id">
        @if (item.Item.Kind != ReviewKind.Concept)
        {
            <div class="content-column"><span class="review-kind mt-4 inline-block rounded-full bg-surface px-[.6rem] py-[.1rem] text-[.8rem] font-medium text-fg-secondary">@(item.Item.Kind == ReviewKind.Pattern ? "Pattern" : "Re-solve")</span></div>
        }
        @if (item.NeedsLargeScreen && Screen.IsPhone && _pick is null)
        {
            <div class="content-column"><p class="large-screen-note mt-4 rounded-lg border border-hairline bg-surface-raised px-4 py-3 text-[.95rem]" role="note">This question is best on a larger screen, where you can type the code. You can still answer it here.</p></div>
        }
        @if (_pick is { } pick)
        {
            @* A pattern pick from Practice: the same unlabelled problem and the choice of patterns, with no hints (the pattern rung is the answer). *@
            <ProblemPrompt Step="Screen.Present(item.Presented)" />
            <PatternPick Choices="pick.Choices" Right="pick.Right" Name="@item.Item.Id" Cue="@item.Question.PatternCue" OnPicked="p => Answered(item, p.Correct)" OnContinue="Next" />
        }
        else
        {
        @switch (Screen.Present(item.Presented))
        {
            case ChoiceStep choice:
                <ChoiceStepView Step="choice" OnAnswered="r => Answered(item, r.IsCorrect)" OnContinue="Next" />
                break;
            case PredictOutputStep predict:
                <PredictOutputStepView Step="predict" OnAnswered="a => Answered(item, a.Result.IsCorrect)" OnContinue="Next" />
                break;
            case FillBlankStep fill:
                <FillBlankStepView Step="fill" OnAnswered="a => Answered(item, a.Result.IsCorrect)" OnContinue="Next" />
                break;
            case ParsonsStep parsons:
                <ParsonsStepView Step="parsons" OnAnswered="a => Answered(item, a.Result.IsCorrect)" OnContinue="Next" />
                break;
            case WriteCodeStep write:
                <WriteCodeStepView Step="write" DraftKey="@DraftKey(item)" OnSubmitted="s => Answered(item, s.Result.Status == TestRunStatus.Passed)" OnContinue="Next" />
                break;
            default:
                <p>This kind of question can't be reviewed here yet.</p>
                <div class="review-actions content-column pb-6"><button class="primary btn-primary" @onclick="Next">Skip</button></div>
                break;
        }
        <HintLadder Hints="Screen.Present(item.Presented).Hints" Walkthrough="Screen.Present(item.Presented).Walkthrough" Initial="item.AttemptHints" Caption="A hint makes this come back sooner." OnRevealed="level => Hinted(item, level)" />
        }
        <FlagStep LessonId="@item.Lesson.Id" StepId="@item.Item.StepId" />
        @if (_scheduled is { } due)
        {
            <p class="review-next content-column mt-4 text-[.95rem] text-fg-secondary" role="status">You'll see this again @Describe(due - Recorder.Now).</p>
        }
    </div>
}
else
{
    <p class="review-done content-column mt-12 mb-4 text-[1.3rem]">@(_waiting > 0 ? "That's all for today." : _queue.Count == 0 && _nextDue is null ? "Nothing to review yet. Finish a lesson and its questions will show up here." : "You're all caught up. 🎉")</p>
    @if (_waiting > 0)
    {
        <p class="review-next content-column mt-4 text-[.95rem] text-fg-secondary">@_waiting more @(_waiting == 1 ? "is" : "are") waiting. They'll be in tomorrow's queue, so a missed day never piles up.</p>
    }
    else if (_nextDue is { } next)
    {
        <p class="review-next content-column mt-4 text-[.95rem] text-fg-secondary">Next review @Describe(next - Recorder.Now).</p>
    }
    <div class="review-actions content-column pb-6"><button class="primary btn-primary" @onclick="Finish">@(FinishedText ?? "Back to tracks")</button></div>
}

@code {
    [Parameter, EditorRequired] public ContentGraph Content { get; set; } = default!;
    [Parameter] public EventCallback OnExit { get; set; }

    /// <summary>Raised by the button at the end of the queue (the Back link raises <see cref="OnExit"/>), so a daily session can tell "done" from "leaving". Falls back to <see cref="OnExit"/>.</summary>
    [Parameter] public EventCallback OnFinished { get; set; }

    /// <summary>The label of the button at the end of the queue.</summary>
    [Parameter] public string? FinishedText { get; set; }

    /// <summary>Raised after an answer is recorded, so whatever shows the due count elsewhere (the sidebar) can refresh.</summary>
    [Parameter] public EventCallback OnProgress { get; set; }

    /// <summary>Changes when progress arrives from another device (sync). The queue is read once when the screen opens, so this is what makes it look again.</summary>
    [Parameter] public int SyncRevision { get; set; }

    private IReadOnlyList<ReviewItemState> _queue = [];
    private int _index;
    private DateTimeOffset _shownAt;
    private bool _recorded;
    private int _hintsUsed;
    private DateTimeOffset? _scheduled;
    private DateTimeOffset? _nextDue;
    private int _waiting;
    private int _seenRevision;
    private bool _stale;
    private (Pattern Right, IReadOnlyList<Pattern> Choices)? _pick;
    private readonly Random _random = new();

    private ReviewItemState? _current => _index < _queue.Count ? _queue[_index] : null;

    protected override void OnInitialized()
    {
        Screen.Changed += OnScreenChanged;
        _seenRevision = SyncRevision;
        _queue = Recorder.Project(Content, Screen.Class).Queue.Items;
        Show();
    }

    public void Dispose() => Screen.Changed -= OnScreenChanged;

    // Turning the phone or resizing the window changes the form later questions are asked in. The one being answered stays as it is.
    private void OnScreenChanged() => _ = InvokeAsync(() =>
    {
        _queue = [.. _queue.Select((q, i) => i <= _index ? q : q.For(Screen.Class))];
        StateHasChanged();
    });

    // Synced progress can unlock or schedule questions. Where the learner is looking at "nothing to review" or "all caught up", start over from
    // what is due now. Mid-queue, leave the question (and any answer in progress) alone and pick the new ones up when they move on.
    protected override void OnParametersSet()
    {
        if (SyncRevision == _seenRevision) return;
        _seenRevision = SyncRevision;
        if (_current is null)
        {
            _queue = Recorder.Project(Content, Screen.Class).Queue.Items;
            _index = 0;
            Show();
        }
        else _stale = true;
    }

    // Questions that became due since the queue was read join the end of it, so the bar only ever grows.
    private void AddNewlyDue()
    {
        var known = _queue.Select(q => q.Item.Id).ToHashSet();
        _queue = [.. _queue, .. Recorder.Project(Content, Screen.Class).Queue.Items.Where(q => !known.Contains(q.Item.Id))];
    }

    private void Show()
    {
        (_recorded, _hintsUsed, _scheduled, _shownAt) = (false, _current?.AttemptHints ?? 0, null, Recorder.Now);
        (_nextDue, _waiting) = _current is null ? Finished() : (null, 0);
        _pick = PickFor(_current);
    }

    // A pick item offers its problem's pattern among others the learner has learned, shuffled afresh each time it is asked.
    private (Pattern Right, IReadOnlyList<Pattern> Choices)? PickFor(ReviewItemState? item)
    {
        if (item is not { IsPracticePick: true } || item.Question.Pattern is not { } id) return null;
        var state = Recorder.Project(Content, Screen.Class);
        if (state.Pattern(id)?.Pattern is not { } right) return null;
        return (right, PracticeSelector.Choices(state, right, _random));
    }

    // Only the first answer to an item counts: retrying is practice, not a better memory.
    private async Task Answered(ReviewItemState item, bool correct)
    {
        if (_recorded) return;
        _recorded = true;
        Recorder.ReviewAnswered(item, correct, item.HintsBefore(_hintsUsed), Recorder.Now - _shownAt);
        _scheduled = Recorder.Project(Content, Screen.Class).Reviews.First(r => r.Item.Id == item.Item.Id).Card?.Due;
        await OnProgress.InvokeAsync();
    }

    // Hints count against the rating only if they were asked for before the first answer; after that the question is practice.
    private void Hinted(ReviewItemState item, int level)
    {
        if (_recorded) return;
        _hintsUsed = Math.Max(_hintsUsed, level);
        Recorder.HintUsed(item.Lesson.Id, item.Item.StepId, level, item.Item.Id);
    }

    // A review attempt keeps its own draft, apart from the lesson's. Counting answers in the key means an interrupted attempt resumes,
    // while the next due attempt (after this one was answered) starts again from the starter.
    private static string DraftKey(ReviewItemState item) => $"review.{item.Item.Id}.{item.Answers}";

    private Task Finish() => (OnFinished.HasDelegate ? OnFinished : OnExit).InvokeAsync();

    private void Next()
    {
        _index++;
        if (_stale)
        {
            _stale = false;
            AddNewlyDue();
        }
        Show();
    }

    // What to tell the learner at the end of the queue: reviews held back by today's cap, or else when the next one is due.
    private (DateTimeOffset? NextDue, int Waiting) Finished()
    {
        var state = Recorder.Project(Content, Screen.Class);
        var next = state.Reviews
            .Where(r => r.IsUnlocked && r.Card is not null && r.Card.Due > state.AsOf)
            .Select(r => (DateTimeOffset?)r.Card!.Due)
            .Min();
        return (next, state.Queue.Waiting);
    }

    private static string Describe(TimeSpan wait) => PracticeText.Describe(wait);
}
