<article class="explain-step lesson-step">
    <h2>@Step.Title</h2>

    <div class="explain-body">@((MarkupString)BodyHtml)</div>

    @foreach (var snippet in Step.Snippets)
    {
        <pre class="code-block" data-language="@snippet.Language"><code>@snippet.Code</code></pre>
    }

    @if (Step.Comparison is { } cmp)
    {
        <div class="comparison grid grid-cols-[1fr_1fr] gap-4 narrow:grid-cols-[1fr]">
            @foreach (var snippet in cmp)
            {
                <section>
                    <h3 class="mt-0 mb-1 text-[.9rem] font-semibold text-fg-secondary">@snippet.Label</h3>
                    <pre class="code-block" data-language="@snippet.Language"><code>@snippet.Code</code></pre>
                </section>
            }
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired] public ExplainStep Step { get; set; } = default!;

    private string BodyHtml => MarkdownHtml.ToHtml(Step.Body);
}
