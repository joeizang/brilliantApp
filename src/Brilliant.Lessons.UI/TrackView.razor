@using Brilliant.Core.Progress
@inject ProgressRecorder Recorder

@{
    var learner = Recorder.Project(Content);
    var state = learner.Track(Track.Id)!;
    var concepts = learner.ConceptsOf(Track.Id).ToList();
}
<div class="crumbs content-column mt-2 text-[.95rem]"><button class="link btn-link" @onclick="() => OnBack.InvokeAsync()">← Tracks</button></div>
<h1 class="screen-title content-column mt-0 mb-1">@Track.Title</h1>
<p class="track-meta content-column mt-0 mb-0 text-fg-secondary">@state.CompletedLessons of @state.TotalLessons lessons complete</p>
<div class="track-mastery mt-2"><MasteryBar Value="learner.TrackMastery(Track.Id)" Label="@("Mastery of " + Track.Title)" Suffix="mastered" /></div>

<ol class="lessons content-column mt-6 mb-6 grid list-none gap-3">
    @foreach (var l in state.Lessons)
    {
        <li class="lesson @l.Status.ToString().ToLowerInvariant() @LessonClass(l.Status)">
            <span class="status w-6 text-center text-[1.2rem] @(l.Status == LessonStatus.Completed ? "text-success" : "")" aria-hidden="true">@Icon(l.Status)</span>
            <span class="lesson-name grid flex-1 font-semibold">
                @l.Lesson.Title
                <small class="font-normal text-fg-secondary">@Caption(l)</small>
            </span>
            @switch (l.Status)
            {
                case LessonStatus.Locked:
                    <button class="primary btn-primary" disabled>Locked</button>
                    break;
                case LessonStatus.Completed when l.NewStepCount > 0:
                    <button class="primary btn-primary" @onclick="() => OnOpenLesson.InvokeAsync((l.Lesson, false))">@(l.NewStepCount == 1 ? "Play new step" : "Play new steps")</button>
                    <button class="secondary btn-secondary" @onclick="() => OnOpenLesson.InvokeAsync((l.Lesson, true))">Review</button>
                    break;
                case LessonStatus.Completed:
                    <button class="secondary btn-secondary" @onclick="() => OnOpenLesson.InvokeAsync((l.Lesson, true))">Review</button>
                    break;
                default:
                    <button class="primary btn-primary" @onclick="() => OnOpenLesson.InvokeAsync((l.Lesson, false))">@(l.Status == LessonStatus.InProgress ? "Continue" : "Start")</button>
                    break;
            }
        </li>
    }
</ol>

@if (concepts.Count > 0)
{
    <h2 class="section-title mt-12 mb-1 text-[1.2rem]">Concepts</h2>
    <p class="track-meta content-column mt-0 mb-0 text-fg-secondary">Mastery counts what you can still recall, not what you've merely read.</p>
    <ul class="concepts mt-4 mb-12 grid list-none gap-2">
        @foreach (var c in concepts)
        {
            <li class="concept @c.Level.ToString().ToLowerInvariant()">
                <button class="@ConceptButton(c.Level)" @onclick="() => OnOpenConcept.InvokeAsync(c.Concept.Id)">
                    <span class="concept-title font-semibold">@c.Concept.Title</span>
                    <span class="level text-[.8rem] @(c.Level == ConceptLevel.Known ? "text-success" : "text-fg-secondary")">@ConceptText.Level(c.Level)</span>
                    <MasteryBar Value="c.Mastery" Label="@("Mastery of " + c.Concept.Title)" />
                </button>
            </li>
        }
    </ul>
}

@code {
    [Parameter, EditorRequired] public ContentGraph Content { get; set; } = default!;
    [Parameter, EditorRequired] public Track Track { get; set; } = default!;
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback<(Lesson Lesson, bool Review)> OnOpenLesson { get; set; }

    /// <summary>A concept was picked; carries its ID.</summary>
    [Parameter] public EventCallback<string> OnOpenConcept { get; set; }

    private static string LessonClass(LessonStatus s) => "panel flex items-center gap-4 px-5 py-4 shadow-(--shadow-card)" + s switch
    {
        LessonStatus.Locked => " opacity-60",
        LessonStatus.Completed => " border-success/50",
        _ => "",
    };

    private static string ConceptButton(ConceptLevel level) =>
        "panel grid min-h-(--touch) w-full cursor-pointer grid-cols-[1fr_auto] items-center gap-x-4 gap-y-1 px-5 py-3 font-inherit text-left text-inherit transition-[translate,box-shadow] duration-250 ease-app hover:-translate-y-[.0625rem] hover:shadow-(--shadow-card) [&_.mastery]:col-span-full"
        + (level == ConceptLevel.NotStarted ? " opacity-75" : "");

    private static string Icon(LessonStatus s) => s switch
    {
        LessonStatus.Completed => "✓",
        LessonStatus.Locked => "🔒",
        LessonStatus.InProgress => "◐",
        _ => "○",
    };

    private static string Caption(LessonState l) => l.Status switch
    {
        LessonStatus.Completed when l.NewStepCount > 0 => $"Completed · {l.NewStepCount} new {(l.NewStepCount == 1 ? "step" : "steps")}",
        LessonStatus.Completed => "Completed",
        LessonStatus.Locked => "Finish the previous lesson to unlock",
        LessonStatus.InProgress => $"{l.Progress.Remaining} of {l.Progress.TotalSteps} steps remaining",
        _ => $"{l.Progress.TotalSteps} steps",
    };
}
