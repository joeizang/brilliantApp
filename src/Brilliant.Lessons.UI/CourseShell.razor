@* Root navigation: Today (home) → the daily session, or Tracks → Track → Lesson (play or review). On wide windows a sidebar lists every track and lesson. *@
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject StepShortcuts Shortcuts
@inject Brilliant.Core.Progress.ProgressRecorder Recorder

<div class="shell block wide:flex wide:min-h-screen">
    <aside class="shell-sidebar hidden wide:sticky wide:top-0 wide:block wide:h-screen wide:flex-[0_0_16rem] wide:self-start wide:overflow-y-auto wide:box-border wide:border-r wide:border-hairline wide:bg-surface-raised/80 wide:px-3 wide:py-6 wide:backdrop-blur-[1.25rem]">
        <CourseSidebar Content="Content" CurrentTrack="_track" CurrentLesson="_lesson" ReviewActive="_reviewing" FlaggedActive="_flagged" TodayActive="IsToday"
                       OnOpenToday="GoToToday" OnOpenTrack="OpenTrack" OnOpenLesson="OpenLessonFromSidebar" OnOpenReview="OpenReview" OnOpenFlagged="OpenFlagged" />
    </aside>
    <main class="shell-main min-w-0 wide:flex-1">
        @if (_session)
        {
            <SessionRunner Content="Content" OnExit="GoToToday" OnProgress="() => StateHasChanged()" />
        }
        else if (_flagged)
        {
            <FlaggedView Content="Content" OnBack="GoToToday" />
        }
        else if (_reviewing)
        {
            <ReviewView Content="Content" OnExit="GoToToday" FinishedText="Back to Today" OnProgress="() => StateHasChanged()" />
        }
        else if (_lesson is { } lesson)
        {
            <LessonViewer @key="(lesson.Id, _review)" Lesson="lesson" Review="_review" OnExit="ExitLesson" OnProgress="() => StateHasChanged()" />
        }
        else if (_concept is { } concept)
        {
            <ConceptView Content="Content" ConceptId="@concept" OnBack="ExitConcept" OnOpenLesson="OpenLesson" />
        }
        else if (_track is { } track)
        {
            <TrackView Content="Content" Track="track" OnBack="BackToTracks" OnOpenLesson="OpenLesson" OnOpenConcept="OpenConcept" />
        }
        else if (_browsing)
        {
            <TracksView Content="Content" OnOpenTrack="OpenTrack" OnOpenReview="OpenReview" OnOpenFlagged="OpenFlagged" OnBack="GoToToday" />
        }
        else
        {
            <TodayView Content="Content" OnStart="StartSession" OnBrowse="BackToTracks" OnOpenReview="OpenReview" />
        }
    </main>
</div>

@code {
    [Parameter, EditorRequired] public ContentGraph Content { get; set; } = default!;

    private Track? _track;
    private Lesson? _lesson;
    private string? _concept;
    private bool _review;
    private bool _reviewing;
    private bool _session;
    private bool _flagged;
    private bool _browsing;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CourseShell>? _self;
    private IDisposable? _shortcuts;

    protected override void OnInitialized() => _shortcuts = Shortcuts.Subscribe(OnShortcut);

    // A content update can complete a lesson (its last unfinished step was deleted). Record that once, so a later update can't undo it.
    protected override void OnParametersSet() => Recorder.RecordCompletionsFrom(Content);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Brilliant.Lessons.UI/shortcuts.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _self);
        }
        catch (JSException) { }   // the app still works with the mouse if the key listener can't start
    }

    /// <summary>Called by the page's key listener (shortcuts.js).</summary>
    [JSInvokable]
    public Task OnShortcut(string command, int number) => Shortcuts.RaiseAsync(command switch
    {
        "run" => new StepShortcut(StepCommand.Run),
        "advance" => new StepShortcut(StepCommand.Advance),
        "choose" => new StepShortcut(StepCommand.Choose, number),
        "previous" => new StepShortcut(StepCommand.Previous),
        "next" => new StepShortcut(StepCommand.Next),
        "playpause" => new StepShortcut(StepCommand.PlayPause),
        _ => throw new ArgumentOutOfRangeException(nameof(command), command, "Unknown shortcut."),
    });

    private bool IsToday => !_session && !_reviewing && !_flagged && !_browsing && _track is null && _lesson is null && _concept is null;

    // Back is the shell's alone: one step up from wherever the learner is (lesson → track → tracks → Today).
    private Task OnShortcut(StepShortcut s) => s.Command != StepCommand.Back ? Task.CompletedTask : InvokeAsync(() =>
    {
        if (_session || _reviewing || _flagged || _browsing) GoToToday();
        else if (_lesson is not null) ExitLesson();
        else if (_concept is not null) ExitConcept();
        else if (_track is not null) BackToTracks();
        StateHasChanged();
    });

    private void OpenTrack(Track track) => (_track, _lesson, _concept, _reviewing, _session, _browsing, _flagged) = (track, null, null, false, false, false, false);
    private void OpenConcept(string conceptId) => _concept = conceptId;
    private void OpenLesson((Lesson Lesson, bool Review) target) => (_lesson, _review) = (target.Lesson, target.Review);
    private void OpenLessonFromSidebar((Track Track, Lesson Lesson, bool Review) target) => (_track, _lesson, _concept, _review, _reviewing, _session, _browsing, _flagged) = (target.Track, target.Lesson, null, target.Review, false, false, false, false);
    private void OpenFlagged() => (_lesson, _track, _concept, _reviewing, _session, _browsing, _flagged) = (null, null, null, false, false, false, true);
    private void OpenReview() => (_lesson, _track, _concept, _reviewing, _session, _browsing, _flagged) = (null, null, null, true, false, false, false);

    // An unfinished session stays open in the log; Today offers to resume it.
    private void StartSession() => (_lesson, _track, _concept, _reviewing, _session, _browsing, _flagged) = (null, null, null, false, true, false, false);

    // Leaving a lesson returns to wherever it was opened from: its concept if it was opened from one (that stays set), else its track.
    private void ExitLesson() => _lesson = null;
    private void ExitConcept() => _concept = null;
    private void BackToTracks() => (_lesson, _track, _concept, _reviewing, _session, _browsing, _flagged) = (null, null, null, false, false, true, false);
    private void GoToToday() => (_lesson, _track, _concept, _reviewing, _session, _browsing, _flagged) = (null, null, null, false, false, false, false);

    public async ValueTask DisposeAsync()
    {
        _shortcuts?.Dispose();
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("detach");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }   // the app is shutting down
        _self?.Dispose();
    }
}
