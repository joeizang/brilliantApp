@using Microsoft.JSInterop
@implements ICodeEditor
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_host" class="code-editor"></div>

@code {
    /// <summary>The code the editor starts with. Later changes go through <see cref="SetCodeAsync"/>.</summary>
    [Parameter] public string InitialCode { get; set; } = "";

    /// <summary>
    /// Called with the full text shortly after the learner stops typing (not for <see cref="SetCodeAsync"/>), and once
    /// more when the editor is disposed if an edit hadn't been reported yet. A plain delegate rather than an EventCallback
    /// so reporting an edit doesn't re-render the parent.
    /// </summary>
    [Parameter] public Action<string>? OnChanged { get; set; }

    private ElementReference _host;
    private IJSObjectReference? _module;
    private int _id;
    private DotNetObjectReference<CodeEditor>? _self;
    private readonly TaskCompletionSource _ready = new(TaskCreationOptions.RunContinuationsAsynchronously);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/Brilliant.Lessons.UI/code-editor.js");
            _self = DotNetObjectReference.Create(this);
            _id = await _module.InvokeAsync<int>("create", _host, InitialCode, _self);
            _ready.SetResult();
        }
        catch (Exception ex)
        {
            _ready.SetException(ex);
        }
    }

    // Callers may arrive before the first render has created the editor; wait for it.
    private async ValueTask<IJSObjectReference> ModuleAsync()
    {
        await _ready.Task;
        return _module!;
    }

    public async ValueTask<string> GetCodeAsync() => await (await ModuleAsync()).InvokeAsync<string>("getCode", _id);

    public async ValueTask SetCodeAsync(string code) => await (await ModuleAsync()).InvokeVoidAsync("setCode", _id, code);

    public async ValueTask SetErrorMarkersAsync(IReadOnlyList<EditorMarker> markers) =>
        await (await ModuleAsync()).InvokeVoidAsync("setErrorMarkers", _id, markers.Select(m => new { line = m.Line, message = m.Message }));

    public async ValueTask ClearErrorMarkersAsync() => await (await ModuleAsync()).InvokeVoidAsync("clearErrorMarkers", _id);

    public async ValueTask HighlightLineAsync(int? line) => await (await ModuleAsync()).InvokeVoidAsync("highlightLine", _id, line);

    [JSInvokable] public void OnJsChanged(string code) => OnChanged?.Invoke(code);

    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try
        {
            await _module.InvokeVoidAsync("flush", _id);   // don't lose the last second of typing when the learner navigates away
            await _module.InvokeVoidAsync("dispose", _id);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { } // the app is shutting down; nothing left to clean up
        finally
        {
            _self?.Dispose();
        }
    }
}
