<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Android is here for the Pyodide spike (issue #2); phone layouts come in the sync milestone. -->
    <TargetFrameworks>net10.0-maccatalyst;net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Brilliant.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Brilliant</ApplicationTitle>
    <ApplicationId>com.joeizang.brilliantapp</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('maccatalyst'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('android'))">24.0</SupportedOSPlatformVersion>
    
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Brilliant.Core\Brilliant.Core.csproj" />
    <ProjectReference Include="..\Brilliant.Data\Brilliant.Data.csproj" />
    <ProjectReference Include="..\Brilliant.Lessons.UI\Brilliant.Lessons.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Content Packs are bundled as raw assets. -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    The pack is rebuilt from ./content whenever a lesson file changes, so a build never ships stale lessons.
    PackContentOuter runs once before a multi-target build fans out (so the two target frameworks don't race to write
    the same file, and the asset glob above sees the file). PackContent covers `dotnet build -f <tfm>`, where there is no
    outer build; after PackContentOuter it finds the pack up to date and skips.
    scripts/pack-content.sh still works for running the pack by hand.
  -->
  <PropertyGroup>
    <ContentRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'content'))</ContentRoot>
    <ContentPackPath>$(MSBuildThisFileDirectory)Resources\Raw\track-1.pack.zip</ContentPackPath>
    <ContentCliProject>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', 'tools', 'Brilliant.Cli', 'Brilliant.Cli.csproj'))</ContentCliProject>
  </PropertyGroup>

  <Target Name="PackContentOuter" BeforeTargets="DispatchToInnerBuilds" DependsOnTargets="PackContentCore" />

  <Target Name="PackContent" BeforeTargets="PrepareForBuild" Condition="'$(TargetFramework)' != ''" DependsOnTargets="PackContentCore">
    <ItemGroup>
      <MauiAsset Remove="$(ContentPackPath)" />
      <MauiAsset Include="$(ContentPackPath)" LogicalName="track-1.pack.zip" />
    </ItemGroup>
  </Target>

  <Target Name="PackContentCore" Inputs="@(ContentPackInput)" Outputs="$(ContentPackPath)">
    <Exec Command="dotnet run --no-launch-profile --project &quot;$(ContentCliProject)&quot; -- pack &quot;$(ContentRoot)&quot; -o &quot;$(ContentPackPath)&quot;" />
  </Target>

  <ItemGroup>
    <ContentPackInput Include="$(ContentRoot)**\*.yaml;$(ContentRoot)**\*.md" />
  </ItemGroup>

</Project>
