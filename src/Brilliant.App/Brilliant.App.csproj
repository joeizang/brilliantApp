<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Android ships as a signed APK (scripts/build-apk.sh, docs/android.md); phone layouts come with #34. -->
    <TargetFrameworks>net10.0-maccatalyst;net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Brilliant.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppRepositoryRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</AppRepositoryRoot>
    <AppManifestPath>$(AppRepositoryRoot)apps/$(BrilliantApp)/manifest.yaml</AppManifestPath>

    <!-- PrepareAppFlavor supplies native identity before the platform's packaging targets. -->
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('maccatalyst'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('android'))">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!--
    Mac Catalyst Release builds are AOT-only by default, and EF Core refuses to build its model at runtime there
    ("Model building is not supported when publishing with NativeAOT"), so the app crashed at launch. The interpreter
    turns dynamic code back on. A compiled EF model would let us drop this; Debug builds use the JIT and never hit it.
  -->
  <PropertyGroup Condition="$(TargetFramework.Contains('maccatalyst')) And '$(Configuration)' == 'Release'">
    <UseInterpreter>true</UseInterpreter>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Brilliant.Core\Brilliant.Core.csproj" />
    <ProjectReference Include="..\Brilliant.Data\Brilliant.Data.csproj" />
    <ProjectReference Include="..\Brilliant.Lessons.UI\Brilliant.Lessons.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Content Packs are bundled as raw assets. -->
    <MauiAsset Include="Resources\Raw\**" Exclude="Resources\Raw\*.pack.zip" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <MauiAsset Include="$(AppManifestPath)" LogicalName="app-manifest.yaml" />
    <Content Remove="wwwroot\index.html" />
  </ItemGroup>

  <!--
    The pack is rebuilt from ./content whenever a lesson file changes, so a build never ships stale lessons.
    Each flavor/framework/RID has its own generated pack and input stamp, so multi-target builds do not race.
    scripts/pack-content.sh still produces a standalone pack for inspecting or publishing by hand.
  -->
  <PropertyGroup>
    <ContentRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'content'))</ContentRoot>
    <!-- Lists the input files, so deleting or renaming one changes an input and the pack is rebuilt (a deleted file is simply absent from @(ContentPackInput), which MSBuild alone can't see). -->
    <ContentManifestPath>$(BaseIntermediateOutputPath)content-pack.inputs.txt</ContentManifestPath>
    <ContentCliProject>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', 'tools', 'Brilliant.Cli', 'Brilliant.Cli.csproj'))</ContentCliProject>
  </PropertyGroup>

  <Target Name="PrepareAppFlavor" BeforeTargets="PrepareForBuild;GetMauiItems;_GetAndroidPackageName;_GenerateBundleName;_CompileAppManifestInputs;ResolveStaticWebAssetsInputs"
          Condition="'$(TargetFramework)' != '' And '$(DesignTimeBuild)' != 'true'">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(BrilliantApp)', '\A[a-z][a-z0-9]*(-[a-z0-9]+)*\z'))" Text="Invalid BrilliantApp flavor name." />
    <Error Condition="!Exists('$(AppManifestPath)')" Text="Unknown app flavor '$(BrilliantApp)': $(AppManifestPath) does not exist." />
    <PropertyGroup>
      <FlavorGeneratedDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'flavor'))</FlavorGeneratedDir>
    </PropertyGroup>
    <Exec Command="dotnet run --no-launch-profile --project &quot;$(ContentCliProject)&quot; -- prepare-app &quot;$(AppManifestPath)&quot; &quot;$(MSBuildProjectDirectory)/wwwroot/index.html&quot; &quot;$(AppRepositoryRoot)&quot; &quot;$(FlavorGeneratedDir)&quot;" />
    <XmlPeek XmlInputPath="$(FlavorGeneratedDir)app.xml" Query="/App/ApplicationId/text()"><Output TaskParameter="Result" PropertyName="ApplicationId" /></XmlPeek>
    <XmlPeek XmlInputPath="$(FlavorGeneratedDir)app.xml" Query="/App/ApplicationTitle/text()"><Output TaskParameter="Result" PropertyName="ApplicationTitle" /></XmlPeek>
    <XmlPeek XmlInputPath="$(FlavorGeneratedDir)app.xml" Query="/App/ContentPack/text()"><Output TaskParameter="Result" PropertyName="AppContentPack" /></XmlPeek>
    <XmlPeek XmlInputPath="$(FlavorGeneratedDir)app.xml" Query="/App/Icon/text()"><Output TaskParameter="Result" PropertyName="FlavorIconPath" /></XmlPeek>
    <PropertyGroup>
      <ContentPackPath>$(FlavorGeneratedDir)$(AppContentPack)</ContentPackPath>
      <ContentManifestPath>$(FlavorGeneratedDir)content-pack.inputs.txt</ContentManifestPath>
      <AndroidManifest Condition="'$(TargetPlatformIdentifier)' == 'android'">$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)', '$(FlavorGeneratedDir)AndroidManifest.xml'))</AndroidManifest>
      <!-- Apple caches this from ApplicationTitle at evaluation; refresh it before _GenerateBundleName. -->
      <_AppBundleName Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst'">$(ApplicationTitle)</_AppBundleName>
      <RunCommand Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst'">$(TargetDir)$(ApplicationTitle).app/Contents/MacOS/$(AssemblyName)</RunCommand>
      <RunArguments Condition="'$(TargetPlatformIdentifier)' == 'maccatalyst'"></RunArguments>
    </PropertyGroup>
    <ItemGroup>
      <Content Include="$(FlavorGeneratedDir)index.html" Link="wwwroot/index.html" CopyToOutputDirectory="PreserveNewest" />
      <MauiIcon Include="$(FlavorIconPath)" Condition="'$(FlavorIconPath)' != ''" />
    </ItemGroup>
  </Target>

  <Target Name="PackContent" BeforeTargets="PrepareForBuild" Condition="'$(TargetFramework)' != ''" DependsOnTargets="PrepareAppFlavor;PackContentCore">
    <ItemGroup>
      <MauiAsset Remove="$(ContentPackPath)" />
      <MauiAsset Include="$(ContentPackPath)" LogicalName="$(AppContentPack)" />
    </ItemGroup>
  </Target>

  <Target Name="PackContentManifest">
    <WriteLinesToFile File="$(ContentManifestPath)" Lines="@(ContentPackInput)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="PackContentCore" DependsOnTargets="PackContentManifest" Inputs="@(ContentPackInput);$(ContentManifestPath)" Outputs="$(ContentPackPath)">
    <Exec Command="dotnet run --no-launch-profile --project &quot;$(ContentCliProject)&quot; -- pack &quot;$(ContentRoot)&quot; -o &quot;$(ContentPackPath)&quot;" />
  </Target>

  <ItemGroup>
    <ContentPackInput Include="$(ContentRoot)**\*.yaml;$(ContentRoot)**\*.md" />
  </ItemGroup>

</Project>
