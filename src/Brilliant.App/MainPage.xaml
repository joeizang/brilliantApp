<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Brilliant.App"
             xmlns:web="clr-namespace:Microsoft.AspNetCore.Components.Web;assembly=Microsoft.AspNetCore.Components.Web"
             x:Class="Brilliant.App.MainPage"
             SafeAreaEdges="{OnPlatform Android=All, Default=None}"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#16171D, Default=#16171D}">
    <BlazorWebView HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <!-- Bootstrap the app before HeadOutlet: putting the head root first leaves Release builds on Loading. -->
            <RootComponent Selector="#app" ComponentType="{x:Type local:Components.Routes}" />
            <RootComponent Selector="head::after" ComponentType="{x:Type web:HeadOutlet}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>
</ContentPage>
