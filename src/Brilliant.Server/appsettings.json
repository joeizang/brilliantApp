{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // The server doesn't use data protection, so its "keys not persisted" warnings are noise.
      "Microsoft.AspNetCore.DataProtection": "Error",
      "Microsoft.EntityFrameworkCore": "Warning",
      // On a fresh database EF probes for its history table and logs the expected miss as an error. Real failures still surface as request errors.
      "Microsoft.EntityFrameworkCore.Database.Command": "Critical"
    }
  },
  "Pairing": {
    "CodeLifetimeMinutes": 15,
    "AttemptsPerMinute": 10
  }
}
